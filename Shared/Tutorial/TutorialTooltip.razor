@inject CryptoView.Services.TutorialService TutorialSvc
@inject CryptoView.Services.LocalizacionService Loc
@implements IDisposable

<div class="cv-tutorial-tooltip @(IsMobile ? "cv-tt-mobile" : "")" role="dialog" aria-modal="true"
     aria-label="@TutorialSvc.GetStepTitle(Step)" @onkeydown="OnKeyDown" tabindex="0" @ref="tooltipRef">

    <!-- Skip button -->
    <div class="cv-tt-header">
        <button class="cv-tt-skip-btn" @onclick="OnSkip" aria-label="@TutorialSvc.GetSkipLabel()">
            @TutorialSvc.GetSkipLabel()
        </button>
    </div>

    <!-- Content -->
    <div class="cv-tt-body" aria-live="polite">
        <h4 class="cv-tt-title">@TutorialSvc.GetStepTitle(Step)</h4>
        <p class="cv-tt-description">@TutorialSvc.GetStepDescription(Step)</p>
    </div>

    <!-- Footer: Got it + step indicator -->
    <div class="cv-tt-footer">
        <span class="cv-tt-step-indicator" aria-live="polite">@TutorialSvc.GetStepIndicator(CurrentStep,
                                    TotalSteps)</span>
            <button class="cv-tt-btn cv-tt-btn-primary" @onclick="OnGotIt">
                @TutorialSvc.GetGotItLabel()
            </button>
        </div>
    </div>

    <style>
        .cv-tutorial-tooltip {
            position: fixed;
            z-index: 10001;
            background: var(--bg-card, #1A2236);
            border: 1px solid var(--accent, #FF7A00);
            border-radius: var(--radius-md, 12px);
            padding: 0;
            width: 320px;
            max-width: calc(100vw - 32px);
            box-shadow: 0 8px 32px rgba(255, 122, 0, 0.18), 0 0 0 1px rgba(255, 122, 0, 0.08);
            font-family: var(--font-body, 'Inter', sans-serif);
            color: var(--text-primary, #E5E7EB);
            outline: none;
            animation: cvTtFadeIn 0.25s ease-out;
        }

        @@keyframes cvTtFadeIn {
            from {
                opacity: 0;
                transform: translateY(6px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .cv-tt-header {
            display: flex;
            justify-content: flex-end;
            padding: 10px 14px 0;
        }

        .cv-tt-skip-btn {
            background: transparent;
            border: none;
            color: var(--text-secondary, #9CA3AF);
            cursor: pointer;
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 0.78rem;
            font-weight: 500;
            transition: all 0.15s ease;
            font-family: inherit;
        }

        .cv-tt-skip-btn:hover {
            color: var(--accent, #FF7A00);
            background: rgba(255, 122, 0, 0.08);
        }

        .cv-tt-body {
            padding: 8px 14px 6px;
        }

        .cv-tt-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--accent, #FF7A00);
            margin: 0 0 6px;
            line-height: 1.3;
        }

        .cv-tt-description {
            font-size: 0.88rem;
            color: var(--text-secondary, #9CA3AF);
            margin: 0;
            line-height: 1.55;
        }

        .cv-tt-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 14px 12px;
        }

        .cv-tt-step-indicator {
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--text-secondary, #9CA3AF);
            opacity: 0.7;
        }

        .cv-tt-btn {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 7px 16px;
            border-radius: var(--radius-sm, 8px);
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all 0.18s ease;
            white-space: nowrap;
            font-family: inherit;
        }

        .cv-tt-btn-primary {
            background: linear-gradient(135deg, var(--accent, #FF7A00) 0%, #e06500 100%);
            color: #fff;
        }

        .cv-tt-btn-primary:hover {
            box-shadow: 0 4px 12px rgba(255, 122, 0, 0.3);
            transform: translateY(-1px);
        }

        /* Mobile: bottom sheet */
        .cv-tt-mobile {
            position: fixed !important;
            bottom: 0 !important;
            left: 0 !important;
            right: 0 !important;
            top: auto !important;
            width: 100% !important;
            max-width: 100% !important;
            border-radius: var(--radius-lg, 16px) var(--radius-lg, 16px) 0 0;
            border-bottom: none;
            max-height: 55vh;
            overflow-y: auto;
            animation: cvTtSlideUp 0.3s ease-out;
        }

        .cv-tt-mobile .cv-tt-footer {
            padding-bottom: max(12px, env(safe-area-inset-bottom));
        }

        @@keyframes cvTtSlideUp {
            from {
                transform: translateY(100%);
            }

            to {
                transform: translateY(0);
            }
        }
    </style>

@code {
    [Parameter] public CryptoView.Models.TutorialStep Step { get; set; } = default!;
    [Parameter] public int CurrentStep { get; set; }
    [Parameter] public int TotalSteps { get; set; }
    [Parameter] public bool IsMobile { get; set; }
    [Parameter] public EventCallback OnGotItClicked { get; set; }
    [Parameter] public EventCallback OnSkipClicked { get; set; }

    private ElementReference tooltipRef;

    protected override void OnInitialized()
    {
        Loc.OnLanguageChanged += HandleLanguageChanged;
    }

    public void Dispose()
    {
        Loc.OnLanguageChanged -= HandleLanguageChanged;
    }

    private void HandleLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await tooltipRef.FocusAsync(); }
            catch { /* non-critical */ }
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            await OnSkipClicked.InvokeAsync();
        else if (e.Key == "Enter")
            await OnGotItClicked.InvokeAsync();
    }

    private async Task OnGotIt() => await OnGotItClicked.InvokeAsync();
    private async Task OnSkip() => await OnSkipClicked.InvokeAsync();
}
