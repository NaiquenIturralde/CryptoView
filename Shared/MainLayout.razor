@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject CryptoView.Services.NotificationService NotificationSvc

<div class="page">
    <div class="sidebar-overlay @(_sidebarOpen ? "visible" : "")" @onclick="CloseSidebar" aria-hidden="true"></div>
    <div class="sidebar @(_sidebarOpen ? "show" : "")">
        <NavMenu OnNavigationRequested="CloseSidebar" />
    </div>

    <main>
        <div class="top-row px-4">
            <button class="hamburger-btn" @onclick="ToggleSidebar"
                    aria-label="@(_sidebarOpen ? "Cerrar menú lateral" : "Abrir menú lateral")"
                    title="@(_sidebarOpen ? "Cerrar menú" : "Abrir menú")">
                <i class="bi @(_sidebarOpen ? "bi-x-lg" : "bi-list")"></i>
            </button>

            <a class="topbar-mobile-brand" href="" @onclick="NavigateToDashboard" @onclick:preventDefault="true"
               title="Ir al Dashboard" aria-label="CryptoView Dashboard">
                <svg class="topbar-logo-svg" viewBox="0 0 120 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M10,40 Q60,-10 110,40 Q60,90 10,40 Z" fill="none" stroke="#FF7A00" stroke-width="3.5"
                          stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="60" cy="40" r="20" fill="none" stroke="#FF7A00" stroke-width="2.5" opacity="0.4" />
                    <circle cx="60" cy="40" r="14" fill="#FF7A00" />
                    <polyline points="44,44 52,36 58,42 66,32 76,38" fill="none" stroke="#fff" stroke-width="2"
                              stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="topbar-brand-name">CryptoView</span>
            </a>

            <div class="ms-auto d-flex align-items-center gap-3">
                <NotificationDropdown />

                <div class="profile-menu @(_profileMenuOpen ? "profile-menu--open" : "")" @onkeydown="OnProfileKeyDown">
                    @if (_profileMenuOpen)
                    {
                        <div class="notif-backdrop" @onclick="CloseUserMenu" aria-hidden="true"></div>
                    }

                    <button type="button"
                            class="profile-toggle btn btn-link text-light p-0 border-0 d-flex align-items-center gap-2"
                            @onclick="ToggleUserMenu" @onclick:stopPropagation="true" aria-label="Menú de usuario"
                            aria-expanded="@_profileMenuOpen.ToString().ToLower()" aria-haspopup="true">
                        <i class="bi bi-person-circle fs-4"></i>
                        <span class="d-none d-md-inline small">@AuthStateSvc.GetCurrentUsername()</span> <i
                        class="profile-caret bi bi-chevron-down ms-1"></i>
                    </button>

                    <ul class="profile-dropdown" @onclick:stopPropagation="true">
                        <li>
                            <a class="dropdown-item" href="perfil">
                                <i class="bi bi-person me-2"></i>Mi perfil
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="preferencias">
                                <i class="bi bi-sliders me-2"></i>Preferencias
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="ayuda">
                                <i class="bi bi-question-circle me-2"></i>Ayuda
                            </a>
                        </li>
                        <li>
                            <hr class="dropdown-divider profile-divider" />
                        </li>
                        <li>
                            <button class="dropdown-item dropdown-item-danger border-0 bg-transparent w-100 text-start"
                                    @onclick="HandleLogout">
                                <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>

    @* ── Modal global de detalle de notificación ── *@
    @if (NotificationSvc.SelectedNotification is { } selected)
    {
        <div class="notif-modal-overlay" @onclick="CloseNotificationModal" aria-hidden="true"></div>

        <div class="notif-modal" role="dialog" aria-label="Detalle de notificación" aria-modal="true"
             @onkeydown="OnModalKeyDown">
            <div class="notif-modal-header notif-modal-type-@selected.TypeName">
                <div class="notif-modal-icon notif-icon-@selected.TypeName">
                    <i class="bi @selected.IconClass"></i>
                </div>
                <h2 class="notif-modal-title">@selected.Title</h2>
            </div>

            <div class="notif-modal-body">
                <p class="notif-modal-message">@selected.Message</p>
                <span class="notif-modal-time">@selected.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
            </div>

            <div class="notif-modal-footer">
                <button class="notif-modal-close-btn" @onclick="CloseNotificationModal" @onclick:stopPropagation="true"
                        autofocus>
                    Cerrar
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool _profileMenuOpen = false;
    private bool _sidebarOpen = false;

    [Inject] private CryptoView.Services.AuthStateService AuthStateSvc { get; set; } = default!;

    private void ToggleSidebar()
    {
        _sidebarOpen = !_sidebarOpen;
        StateHasChanged();
    }

    private void CloseSidebar()
    {
        _sidebarOpen = false;
        StateHasChanged();
    }

    private void NavigateToDashboard()
    {
        if (AuthStateSvc.IsAuthenticated())
            Nav.NavigateTo("/");
        else
            Nav.NavigateTo("/login");
    }

    private void ToggleUserMenu()
    {
        _profileMenuOpen = !_profileMenuOpen;
        StateHasChanged();
    }

    private void CloseUserMenu()
    {
        _profileMenuOpen = false;
        StateHasChanged();
    }

    private void OnProfileKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CloseUserMenu();
    }

    // ── Notification modal ──────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        NotificationSvc.OnModalChanged += HandleModalChanged;
    }

    public void Dispose()
    {
        NotificationSvc.OnModalChanged -= HandleModalChanged;
    }

    private void HandleModalChanged()
        => InvokeAsync(StateHasChanged);

    private void CloseNotificationModal()
    {
        NotificationSvc.CloseModal();
    }

    private void OnModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CloseNotificationModal();
    }

    private async Task HandleLogout()
    {
        _profileMenuOpen = false;
        Console.WriteLine("Logout ejecutado");
        await JS.InvokeVoidAsync("sessionManager.logout");
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
