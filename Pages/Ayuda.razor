@page "/ayuda"
@inject NavigationManager Nav
@inject CryptoView.Services.AuthStateService AuthStateSvc
@inject CryptoView.Services.LocalizacionService Loc
@inject CryptoView.Services.TutorialService TutorialSvc
@implements IDisposable

<PageTitle>@Loc["help.pageTitle"] - CryptoView</PageTitle>

<div class="page-container help-container">
    <!-- Page Header -->
    <div class="page-header">
        <h1 class="display-5 fw-bold text-warning mb-1">@Loc["help.title"]</h1>
        <p class="text-muted lead mb-0">@Loc["help.subtitle"]</p>
    </div>

    <!-- Card 1: Dashboard -->
    <div class="help-card">
        <div class="help-card-title">
            <i class="bi bi-speedometer2"></i> @Loc["help.card1.title"]
        </div>
        <p>@Loc["help.card1.desc"]</p>
        <ul>
            <li><strong>@Loc["help.card1.totalCoins"]</strong> — @Loc["help.card1.totalCoinsDesc"]</li>
            <li><strong>@Loc["help.card1.trendingUp"]</strong> — @Loc["help.card1.trendingUpDesc"]</li>
            <li><strong>@Loc["help.card1.trendingDown"]</strong> — @Loc["help.card1.trendingDownDesc"]</li>
            <li><strong>@Loc["help.card1.avgChange"]</strong> — @Loc["help.card1.avgChangeDesc"]</li>
            <li>@Loc["help.card1.info"]</li>
        </ul>
    </div>

    <!-- Card 2: En Alza / En Baja -->
    <div class="help-card">
        <div class="help-card-title">
            <i class="bi bi-bar-chart-line"></i> @Loc["help.card2.title"]
        </div>
        <p>@Loc["help.card2.desc"]</p>
        <div class="d-flex gap-3 flex-wrap mb-2">
            <span class="help-badge help-badge-up">
                <i class="bi bi-arrow-up"></i> @Loc["help.card2.badgeUp"]
            </span>
            <span class="help-badge help-badge-down">
                <i class="bi bi-arrow-down"></i> @Loc["help.card2.badgeDown"]
            </span>
        </div>
        <ul>
            <li>@((MarkupString)Loc["help.card2.positiveDesc"])</li>
            <li>@((MarkupString)Loc["help.card2.negativeDesc"])</li>
            <li>@Loc["help.card2.coinGecko"]</li>
        </ul>
    </div>

    <!-- Card 3: Actualizar Precios -->
    <div class="help-card">
        <div class="help-card-title">
            <i class="bi bi-arrow-clockwise"></i> @Loc["help.card3.title"]
        </div>
        <p>@Loc["help.card3.desc"]</p>
        <ul>
            <li>@Loc["help.card3.item1"]</li>
            <li>@Loc["help.card3.item2"]</li>
            <li>@Loc["help.card3.item3"]</li>
            <li>@Loc["help.card3.item4"]</li>
        </ul>
    </div>

    <!-- Card 4: Frecuencia de datos -->
    <div class="help-card">
        <div class="help-card-title">
            <i class="bi bi-clock-history"></i> @Loc["help.card4.title"]
        </div>
        <p>@((MarkupString)Loc["help.card4.desc"])</p>
        <ul>
            <li>@Loc["help.card4.item1"]</li>
            <li>@Loc["help.card4.item2"]</li>
            <li>@Loc["help.card4.item3"]</li>
        </ul>
    </div>

    <!-- ═══ Recorrido Guiado ═══ -->
    <div class="help-card">
        <div class="help-card-title">
            <i class="bi bi-signpost-split"></i> @Loc["help.tour.title"]
        </div>
        <p>@Loc["help.tour.desc"]</p>

        <button class="btn btn-outline-warning mt-2" @onclick="RestartTour">
            <i class="bi bi-play-circle me-1"></i>@Loc["help.tour.button"]
        </button>

        @if (_resetConfirmed)
        {
            <div class="mt-2 text-success" style="font-size:0.85rem;">
                <i class="bi bi-check-circle-fill me-1"></i>@Loc["help.tour.resetConfirm"]
            </div>
        }
    </div>
</div>

<style>
    .tutorial-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.6rem 0.85rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: var(--radius-sm, 8px);
        transition: background 0.15s ease;
    }

    .tutorial-row:hover {
        background: rgba(255, 122, 0, 0.06);
    }

    .tutorial-row-label {
        font-size: 0.9rem;
        color: var(--text-primary, #E5E7EB);
        font-weight: 500;
    }
</style>

@code {
    [CascadingParameter(Name = "AuthInitialized")] bool AuthInitialized { get; set; } = true;

    private bool _resetConfirmed = false;

    protected override async Task OnInitializedAsync()
    {
        Loc.OnLanguageChanged += HandleLanguageChanged;

        if (!AuthInitialized) return;
        if (!AuthStateSvc.IsAuthenticated())
        {
            Nav.NavigateTo("/login", forceLoad: true);
        }
    }

    private async Task RestartTour()
    {
        await TutorialSvc.ResetTutorialAsync("main-tour");
        Nav.NavigateTo("/");
    }

    private void HandleLanguageChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Loc.OnLanguageChanged -= HandleLanguageChanged;
    }
}