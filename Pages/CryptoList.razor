@code {
    [Inject] private CryptoDbContext DbContext { get; set; } = default!;

    private List<CryptoCurrency> cryptos = new();
    private string searchTerm = string.Empty;
    private string searchQuery = string.Empty;
    private bool isLoading = false;
    private bool isSearching = false;
    private bool searchAttempted = false;
    private bool showModal = false;
    private bool showNotesModal = false;
    private bool isEditMode = false;
    private CryptoCurrency currentCrypto = new();
    private CryptoCurrency? selectedCrypto;
    private UserNote newNote = new();
    private string? modalError;
    private string? noteValidationError;
    private List<(string Id, string Name, string Symbol)> searchResults = new();
    private int selectedResultIndex = -1;
    private HashSet<int> expandedCryptoIds = new();

    private IEnumerable<CryptoCurrency> FilteredCryptos =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? cryptos
            : cryptos.Where(c =>
                c.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                c.Symbol.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                c.CoinId.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    [CascadingParameter(Name = "AuthInitialized")] bool AuthInitialized { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthInitialized) return;
        if (!AuthStateSvc.IsAuthenticated())
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }
        Loc.OnLanguageChanged += HandleLanguageChanged;
        await LoadCryptoCurrencies();
    }

    private async Task LoadCryptoCurrencies()
    {
        var userId = AuthStateSvc.GetCurrentUserId();
        if (userId.HasValue)
            cryptos = await FavoriteCryptoSvc.GetFavoriteCryptosAsync(userId.Value);
        else
            cryptos = new List<CryptoCurrency>();
    }

    private void ShowAddModal()
    {
        isEditMode = false;
        currentCrypto = new CryptoCurrency();
        searchQuery = string.Empty;
        searchResults.Clear();
        searchAttempted = false;
        modalError = null;
        selectedResultIndex = -1;
        showModal = true;
    }

    private void ShowEditModal(CryptoCurrency crypto)
    {
        isEditMode = true;
        currentCrypto = new CryptoCurrency
        {
            Id = crypto.Id,
            CoinId = crypto.CoinId,
            Name = crypto.Name,
            Symbol = crypto.Symbol,
            PriceThreshold = crypto.PriceThreshold
        };
        modalError = null;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        currentCrypto = new();
        modalError = null;
    }

    private async Task SaveCrypto()
    {
        try
        {
            isLoading = true;
            modalError = null;

            var userId = AuthStateSvc.GetCurrentUserId();
            if (!userId.HasValue)
            {
                modalError = Loc["cryptolist.invalidSession"];
                return;
            }

            if (isEditMode)
            {
                // Editar: solo actualizar datos del catálogo si la moneda existe
                var existing = await DbContext.CryptoCurrencies.FindAsync(currentCrypto.Id);
                if (existing != null)
                {
                    existing.Name = currentCrypto.Name;
                    existing.Symbol = currentCrypto.Symbol;
                    existing.PriceThreshold = currentCrypto.PriceThreshold;
                    await DbContext.SaveChangesAsync();
                }
            }
            else
            {
                // Agregar nueva moneda
                var coinIdLower = currentCrypto.CoinId.ToLower().Trim();
                Console.WriteLine($"[AddCrypto] Intentando agregar CoinId='{coinIdLower}'");

                // 1. Buscar en catálogo global (sin importar IsActive)
                var existingInCatalog = await DbContext.CryptoCurrencies
                    .FirstOrDefaultAsync(c => c.CoinId.ToLower() == coinIdLower);

                int cryptoIdToAdd;

                if (existingInCatalog != null)
                {
                    // La moneda ya existe en el catálogo — reutilizar
                    Console.WriteLine($"[AddCrypto] Existe en catálogo: Id={existingInCatalog.Id}, Name={existingInCatalog.Name}");
                    cryptoIdToAdd = existingInCatalog.Id;
                }
                else
                {
                    // No existe en catálogo — crear nueva entrada
                    Console.WriteLine($"[AddCrypto] No existe, creando en catálogo.");
                    var priceData = await ApiService.GetCoinPriceAsync(coinIdLower);
                    if (priceData != null)
                    {
                        currentCrypto.CurrentPrice = priceData.Price;
                        currentCrypto.MarketCap = priceData.MarketCap;
                        currentCrypto.Volume24h = priceData.Volume24h;
                        currentCrypto.Change24h = priceData.Change24h;
                        currentCrypto.LastUpdated = priceData.LastUpdated;
                    }
                    currentCrypto.CoinId = coinIdLower;
                    currentCrypto.DateAdded = DateTime.UtcNow;
                    currentCrypto.IsActive = true;
                    DbContext.CryptoCurrencies.Add(currentCrypto);
                    await DbContext.SaveChangesAsync();
                    cryptoIdToAdd = currentCrypto.Id;
                    Console.WriteLine($"[AddCrypto] Creada en catálogo con Id={cryptoIdToAdd}");
                }

                // 2. Agregar a FavoriteCryptoIds del usuario actual
                var added = await FavoriteCryptoSvc.AddFavoriteCryptoAsync(userId.Value, cryptoIdToAdd);
                if (added)
                {
                    Console.WriteLine($"[AddCrypto] Agregada a favoritos: cryptoId={cryptoIdToAdd}");
                    NotificationSvc.NotifyCryptoAdded(currentCrypto.Name);
                }
                else
                {
                    modalError = Loc["cryptolist.alreadyInList"];
                    return;
                }
            }

            await LoadCryptoCurrencies();
            CloseModal();
        }
        catch (Exception ex)
        {
            modalError = Loc.Format("cryptolist.errorPrefix", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteCrypto(CryptoCurrency crypto)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", Loc.Format("cryptolist.confirmDelete", crypto.Name)))
        {
            var userId = AuthStateSvc.GetCurrentUserId();
            if (userId.HasValue)
            {
                // SOLO quitar de FavoriteCryptoIds del usuario actual.
                // NO tocar CryptoCurrencies (catálogo global intacto).
                await FavoriteCryptoSvc.RemoveFavoriteCryptoAsync(userId.Value, crypto.Id);
            }
            await LoadCryptoCurrencies();
            NotificationSvc.NotifyCryptoDeleted(crypto.Name);
        }
    }

    private async Task RefreshCrypto(CryptoCurrency crypto)
    {
        var priceData = await ApiService.GetCoinPriceAsync(crypto.CoinId.ToLower());
        if (priceData != null)
        {
            // Comparar precio almacenado vs nuevo ANTES de sobrescribirlo
            NotificationSvc.NotifyPriceAlert(crypto.Name, crypto.CurrentPrice, priceData.Price);

            crypto.CurrentPrice = priceData.Price;
            crypto.MarketCap = priceData.MarketCap;
            crypto.Volume24h = priceData.Volume24h;
            crypto.Change24h = priceData.Change24h;
            crypto.LastUpdated = priceData.LastUpdated;
            await DbContext.SaveChangesAsync();

            NotificationSvc.NotifyPriceUpdateSuccess(1);
            StateHasChanged();
        }
        else
        {
            NotificationSvc.NotifyPriceUpdateError();
        }
    }

    private async Task RefreshAllPrices()
    {
        if (cryptos.Count == 0) return;

        try
        {
            isLoading = true;
            var coinIds = cryptos.Select(c => c.CoinId.ToLower()).ToList();
            var pricesData = await ApiService.GetMultipleCoinPricesAsync(coinIds);

            int updated = 0;
            foreach (var crypto in cryptos)
            {
                var priceData = pricesData.FirstOrDefault(p =>
                    p.CoinId.Equals(crypto.CoinId, StringComparison.OrdinalIgnoreCase));

                if (priceData != null)
                {
                    // Comparar precio almacenado vs nuevo ANTES de sobrescribirlo
                    NotificationSvc.NotifyPriceAlert(crypto.Name, crypto.CurrentPrice, priceData.Price);

                    crypto.CurrentPrice = priceData.Price;
                    crypto.MarketCap = priceData.MarketCap;
                    crypto.Volume24h = priceData.Volume24h;
                    crypto.Change24h = priceData.Change24h;
                    crypto.LastUpdated = priceData.LastUpdated;
                    updated++;
                }
            }

            await DbContext.SaveChangesAsync();

            if (updated > 0)
                NotificationSvc.NotifyPriceUpdateSuccess(updated);
            else
                NotificationSvc.NotifyPriceUpdateError();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error refreshing prices: {ex.Message}");
            NotificationSvc.NotifyPriceUpdateError();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowNotesModal(CryptoCurrency crypto)
    {
        selectedCrypto = crypto;
        newNote = new UserNote { CryptoCurrencyId = crypto.Id, Priority = 2 };
        showNotesModal = true;
    }

    private void CloseNotesModal()
    {
        showNotesModal = false;
        selectedCrypto = null;
        newNote = new();
        noteValidationError = null;
    }

    private async Task AddNoteWithValidation()
    {
        noteValidationError = null;
        if (string.IsNullOrWhiteSpace(newNote.Title))
        {
            noteValidationError = Loc["cryptolist.titleRequired"];
            return;
        }
        if (string.IsNullOrWhiteSpace(newNote.Content))
        {
            noteValidationError = Loc["cryptolist.contentRequired"];
            return;
        }
        await AddNote();
        noteValidationError = null;
    }

    private async Task AddNote()
    {
        if (selectedCrypto == null) return;

        newNote.CreatedAt = DateTime.UtcNow;
        newNote.UpdatedAt = DateTime.UtcNow;
        DbContext.UserNotes.Add(newNote);
        await DbContext.SaveChangesAsync();

        await LoadCryptoCurrencies();
        selectedCrypto = cryptos.FirstOrDefault(c => c.Id == selectedCrypto.Id);
        newNote = new UserNote { CryptoCurrencyId = selectedCrypto!.Id, Priority = 2 };
    }

    private async Task DeleteNote(UserNote note)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", Loc["cryptolist.confirmDeleteNote"]))
        {
            DbContext.UserNotes.Remove(note);
            await DbContext.SaveChangesAsync();
            await LoadCryptoCurrencies();
            selectedCrypto = cryptos.FirstOrDefault(c => c.Id == selectedCrypto!.Id);
        }
    }

    // ── Keyboard handlers ─────────────────────────────────────────────────────

    private async Task OnSearchInputKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                CloseModal();
                return;

            case "ArrowDown":
                if (searchResults.Any())
                    selectedResultIndex = Math.Min(selectedResultIndex + 1, searchResults.Count - 1);
                return;

            case "ArrowUp":
                if (searchResults.Any())
                    selectedResultIndex = Math.Max(selectedResultIndex - 1, 0);
                return;

            case "Enter":
                if (isSearching || isEditMode) return;

                if (searchResults.Any())
                {
                    // Confirm currently highlighted result (or first if none highlighted)
                    var idx = selectedResultIndex >= 0 ? selectedResultIndex : 0;
                    SelectCoin(searchResults[idx]);
                }
                else if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    // No results shown yet — run the search
                    await SearchCoins();
                }
                else if (!string.IsNullOrWhiteSpace(currentCrypto.CoinId))
                {
                    // Coin already selected, submit the form
                    await SaveCrypto();
                }
                return;
        }
    }

    private async Task SearchCoins()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            modalError = Loc["cryptolist.pleaseWriteName"];
            return;
        }

        try
        {
            isSearching = true;
            searchAttempted = true;
            searchResults.Clear();
            modalError = null;

            // Buscar en la API de Coinlore
            var results = await ApiService.SearchCoinsAsync(searchQuery);

            if (results.Any())
            {
                searchResults = results;
                selectedResultIndex = 0; // auto-select first result
            }
            else
            {
                modalError = Loc.Format("cryptolist.noResultsFor", searchQuery);
            }
        }
        catch (Exception ex)
        {
            modalError = Loc.Format("cryptolist.searchError", ex.Message);
        }
        finally
        {
            isSearching = false;
        }
    }

    private void SelectCoin((string Id, string Name, string Symbol) coin)
    {
        // Autocompletar los campos con la moneda seleccionada
        currentCrypto.CoinId = coin.Id;
        currentCrypto.Name = coin.Name;
        currentCrypto.Symbol = coin.Symbol;

        // Limpiar resultados de búsqueda
        searchResults.Clear();
        searchQuery = string.Empty;
        searchAttempted = false;
        modalError = null;
        selectedResultIndex = -1;

        StateHasChanged();
    }

    private void ToggleCardExpand(int cryptoId)
    {
        if (expandedCryptoIds.Contains(cryptoId))
            expandedCryptoIds.Remove(cryptoId);
        else
            expandedCryptoIds.Add(cryptoId);
    }

    private void OnCardKeyDown(KeyboardEventArgs e, int cryptoId)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            ToggleCardExpand(cryptoId);
        }
    }

    private string FormatLargeNumber(decimal number)
    {
        if (number >= 1_000_000_000)
            return $"{(number / 1_000_000_000):F2}B";
        if (number >= 1_000_000)
            return $"{(number / 1_000_000):F2}M";
        if (number >= 1_000)
            return $"{(number / 1_000):F2}K";
        return number.ToString("N2");
    }

    private string GetPriorityIcon(int priority) => priority switch
    {
        1 => "🟢",
        2 => "🟡",
        3 => "🔴",
        _ => "⚪"
    };

    private string NotesLabel(int count) => count == 1
        ? Loc.Format("cryptolist.notesCountSingular", count)
        : Loc.Format("cryptolist.notesCountPlural", count);

    private void HandleLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Loc.OnLanguageChanged -= HandleLanguageChanged;
    }
}
