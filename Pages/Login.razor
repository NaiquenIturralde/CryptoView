@page "/login"
@layout EmptyLayout
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject CryptoView.Services.AuthService AuthSvc
@inject CryptoView.Services.AuthStateService AuthStateSvc
@inject CryptoView.Services.LocalizacionService Loc

<PageTitle>@Loc["login.pageTitle"] - CryptoView</PageTitle>

@if (showRegister)
{
    <!-- ══ REGISTRO ══ -->
    <div class="login-wrapper">
        <div class="login-card">

            <button class="login-close-btn" @onclick="CloseRegister" title="@Loc["login.backToLogin"]">
                <i class="bi bi-x-lg"></i>
            </button>

            <div class="login-brand">
                <svg class="login-logo-svg" viewBox="0 0 120 80" xmlns="http://www.w3.org/2000/svg" aria-label="CryptoView"
                     role="img">
                    <path d="M10,40 Q60,-10 110,40 Q60,90 10,40 Z" fill="none" stroke="#FF7A00" stroke-width="3.5"
                          stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="60" cy="40" r="20" fill="none" stroke="#FF7A00" stroke-width="2.5" opacity="0.5" />
                    <circle cx="60" cy="40" r="14" fill="#FF7A00" opacity="0.9" />
                    <polyline points="44,44 52,36 58,42 66,32 76,38" fill="none" stroke="#fff" stroke-width="2"
                              stroke-linecap="round" stroke-linejoin="round" opacity="0.9" />
                </svg>
                <h2 class="login-title">CryptoView</h2>
                <p class="login-subtitle">@Loc["login.subtitle"]</p>
            </div>

            <h5 class="login-heading mb-3 text-center">@Loc["register.title"]</h5>

            <div class="mb-3">
                <label class="form-label login-label" for="reg-nombre">@Loc["profile.edit.firstName"]</label>
                <input id="reg-nombre" type="text" class="form-control login-input @(!string.IsNullOrEmpty(regError) ? "input-error" : "")" @bind="regNombre"
                       placeholder="@Loc["profile.edit.firstNamePlaceholder"]" autocomplete="given-name"
                       aria-describedby="@(!string.IsNullOrEmpty(regError) ? "reg-error" : null)" aria-invalid="@(!string.IsNullOrEmpty(regError) ? "true" : "false")"
                       @onkeydown="@(async (e) => { if (e.Key == "Enter") await DoRegister(); })" />
            </div>

            <div class="mb-3">
                <label class="form-label login-label" for="reg-apellido">@Loc["profile.edit.lastName"]</label>
                <input id="reg-apellido" type="text" class="form-control login-input @(!string.IsNullOrEmpty(regError) ? "input-error" : "")" @bind="regApellido"
                       placeholder="@Loc["profile.edit.lastNamePlaceholder"]" autocomplete="family-name"
                       aria-describedby="@(!string.IsNullOrEmpty(regError) ? "reg-error" : null)" aria-invalid="@(!string.IsNullOrEmpty(regError) ? "true" : "false")"
                       @onkeydown="@(async (e) => { if (e.Key == "Enter") await DoRegister(); })" />
            </div>

            <div class="mb-3">
                <label class="form-label login-label" for="reg-username">@Loc["register.username"]</label>
                <input id="reg-username" type="text" class="form-control login-input @(!string.IsNullOrEmpty(regError) ? "input-error" : "")" @bind="regUsername"
                       placeholder="@Loc["register.usernamePlaceholder"]" autocomplete="username"
                       aria-describedby="@(!string.IsNullOrEmpty(regError) ? "reg-error" : null)" aria-invalid="@(!string.IsNullOrEmpty(regError) ? "true" : "false")"
                       @onkeydown="@(async (e) => { if (e.Key == "Enter") await DoRegister(); })" />
            </div>

            <div class="mb-3">
                <label class="form-label login-label" for="reg-email">@Loc["register.email"] <span class="login-optional">@Loc["register.emailOptional"]</span></label>
                <input id="reg-email" type="email" class="form-control login-input @(!string.IsNullOrEmpty(regError) ? "input-error" : "")" @bind="regEmail" placeholder="@Loc["register.emailPlaceholder"]" autocomplete="email"
                       aria-describedby="@(!string.IsNullOrEmpty(regError) ? "reg-error" : null)" aria-invalid="@(!string.IsNullOrEmpty(regError) ? "true" : "false")"
                       @onkeydown="@(async (e) => { if (e.Key == "Enter") await DoRegister(); })" />
            </div>

            <div class="mb-3">
                <label class="form-label login-label" for="reg-password">@Loc["register.password"]</label>
                <input id="reg-password" type="password" class="form-control login-input @(!string.IsNullOrEmpty(regError) ? "input-error" : "")" @bind="regPassword"
                       placeholder="@Loc["register.passwordPlaceholder"]" autocomplete="new-password"
                       aria-describedby="@(!string.IsNullOrEmpty(regError) ? "reg-error" : null)" aria-invalid="@(!string.IsNullOrEmpty(regError) ? "true" : "false")"
                       @onkeydown="@(async (e) => { if (e.Key == "Enter") await DoRegister(); })" />
            </div>

            <div class="mb-4">
                <label class="form-label login-label" for="reg-confirm">@Loc["register.confirmPassword"]</label>
                <input id="reg-confirm" type="password" class="form-control login-input @(!string.IsNullOrEmpty(regError) ? "input-error" : "")" @bind="regConfirm"
                       placeholder="@Loc["register.confirmPlaceholder"]" autocomplete="new-password"
                       aria-describedby="@(!string.IsNullOrEmpty(regError) ? "reg-error" : null)" aria-invalid="@(!string.IsNullOrEmpty(regError) ? "true" : "false")"
                       @onkeydown="@(async (e) => { if (e.Key == "Enter") await DoRegister(); })" />
            </div>

            @if (!string.IsNullOrEmpty(regError))
            {
                <div id="reg-error" class="alert alert-error alert-danger py-3 mb-3 alert-shake" role="alert" aria-live="polite">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-exclamation-circle-fill flex-shrink-0 mt-1"></i>
                        <div>
                            <strong>@Loc["register.error.title"]</strong>
                            <p class="mb-0 mt-1">@regError</p>
                        </div>
                    </div>
                </div>
            }
            @if (!string.IsNullOrEmpty(regSuccess))
            {
                <div class="alert alert-success py-2 mb-3">@regSuccess</div>
            }

            <button class="btn login-btn w-100 mb-3" @onclick="DoRegister" disabled="@isRegisterLoading">
                @if (isRegisterLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>@Loc["register.creating"]</span>
                }
                else
                {
                    <i class="bi bi-person-plus me-2"></i><span>@Loc["register.title"]</span>
                }
            </button>

            <p class="login-cta text-center">
                @Loc["register.alreadyHasAccount"]
                <button class="login-cta-link" @onclick="CloseRegister">@Loc["register.signInLink"]</button>
            </p>

        </div>
    </div>
}
else
{
    <!-- ══ LOGIN ══ -->
    <div class="login-wrapper">
        <div class="login-card">

            <button class="login-close-btn" @onclick="GoHome" title="@Loc["login.goHome"]">
                <i class="bi bi-x-lg"></i>
            </button>

            <div class="login-brand">
                <svg class="login-logo-svg" viewBox="0 0 120 80" xmlns="http://www.w3.org/2000/svg" aria-label="CryptoView"
                     role="img">
                    <path d="M10,40 Q60,-10 110,40 Q60,90 10,40 Z" fill="none" stroke="#FF7A00" stroke-width="3.5"
                          stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="60" cy="40" r="20" fill="none" stroke="#FF7A00" stroke-width="2.5" opacity="0.5" />
                    <circle cx="60" cy="40" r="14" fill="#FF7A00" opacity="0.9" />
                    <polyline points="44,44 52,36 58,42 66,32 76,38" fill="none" stroke="#fff" stroke-width="2"
                              stroke-linecap="round" stroke-linejoin="round" opacity="0.9" />
                </svg>
                <h2 class="login-title">CryptoView</h2>
                <p class="login-subtitle">@Loc["login.subtitle"]</p>
            </div>

            <h5 class="login-heading mb-4 text-center">@Loc["login.title"]</h5>

            <div class="mb-3">
                <label class="form-label login-label" for="login-username">@Loc["login.username"]</label>
                <input id="login-username" type="text" class="form-control login-input @(!string.IsNullOrEmpty(errorMessage) ? "input-error" : "")" @bind="username" @bind:event="oninput"
                       placeholder="@Loc["login.usernamePlaceholder"]" @ref="usernameInput" autocomplete="username"
                       aria-describedby="@(!string.IsNullOrEmpty(errorMessage) ? "login-error" : null)" aria-invalid="@(!string.IsNullOrEmpty(errorMessage) ? "true" : "false")"
                       @onkeydown="@(async (e) => { if (e.Key == "Enter") await DoLogin(); })" />
            </div>

            <div class="mb-3">
                <label class="form-label login-label" for="login-password">@Loc["login.password"]</label>
                <div class="login-input-group">
                    <input id="login-password" type="@(showPassword ? "text" : "password")" class="form-control login-input login-input-pwd @(!string.IsNullOrEmpty(errorMessage) ? "input-error" : "")"
                           @bind="password" @bind:event="oninput" placeholder="@Loc["login.passwordPlaceholder"]" autocomplete="current-password"
                           aria-describedby="@(!string.IsNullOrEmpty(errorMessage) ? "login-error" : null)" aria-invalid="@(!string.IsNullOrEmpty(errorMessage) ? "true" : "false")"
                           @onkeydown="@(async (e) => { if (e.Key == "Enter") await DoLogin(); })" />
                    <button class="login-pwd-toggle" type="button" @onclick="TogglePassword" tabindex="-1"
                            aria-label="@(showPassword ? Loc["login.hidePassword"] : Loc["login.showPassword"])">
                        <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                </div>
            </div>

            <!-- Error message with animation -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div id="login-error" class="alert alert-error alert-danger py-3 mb-3 alert-shake" role="alert" aria-live="polite">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-exclamation-circle-fill flex-shrink-0 mt-1"></i>
                        <div>
                            <strong>@Loc["login.error.title"]</strong>
                            <p class="mb-0 mt-1">@errorMessage</p>
                        </div>
                    </div>
                </div>
            }

            <!-- Password recovery link — visible solo tras error real de login -->
            <div class="mb-4 text-end" style="min-height: 2rem;">
                @if (showForgotPassword)
                {
                    <button id="forgot-password-btn" class="login-recovery-link login-recovery-animated" @onclick="OpenPasswordRecovery"
                          title="@Loc["login.forgotPassword"]" @ref="forgotPasswordBtn">
                        <i class="bi bi-key me-1"></i>@Loc["login.forgotPassword"]
                    </button>
                }
            </div>

            <button class="btn login-btn w-100 position-relative" @onclick="DoLogin" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>@Loc["login.loggingIn"]</span>
                }
                else
                {
                    <i class="bi bi-box-arrow-in-right me-2"></i><span>@Loc["login.signIn"]</span>
                }
            </button>

            <p class="login-cta text-center mt-4">
                @Loc["login.newHere"]
                <button class="login-cta-link" @onclick="OpenRegister">@Loc["login.registerLink"]</button>
            </p>

        </div>
    </div>
}

<!-- Password Recovery Modal -->
@if (showPasswordRecoveryModal)
{
    <div class="login-modal-overlay" @onclick="ClosePasswordRecovery">
        <div id="recovery-modal" class="login-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="recovery-modal-title" @ref="recoveryModal">
            <button class="login-modal-close" @onclick="ClosePasswordRecovery">
                <i class="bi bi-x-lg"></i>
            </button>

            <div class="login-modal-header">
                <i class="bi bi-key-fill"></i>
                <h3 id="recovery-modal-title">@Loc["login.recovery.title"]</h3>
            </div>

            <div class="login-modal-body">
                <p class="text-muted mb-4">
                    @Loc["login.recovery.description"]
                </p>

                <div class="mb-3">
                    <label class="form-label login-label" for="recovery-username">@Loc["login.username"]</label>
                    <input id="recovery-username" type="text" class="form-control login-input @(!string.IsNullOrEmpty(recoveryError) ? "input-error" : "")" @bind="recoveryUsername"
                           placeholder="@Loc["login.recovery.usernamePlaceholder"]" autocomplete="username"
                           aria-describedby="@(!string.IsNullOrEmpty(recoveryError) ? "recovery-error" : null)" aria-invalid="@(!string.IsNullOrEmpty(recoveryError) ? "true" : "false")"
                           @onkeydown="@(async (e) => { if (e.Key == "Enter") await SubmitRecovery(); })" />
                </div>

                @if (!string.IsNullOrEmpty(recoveryError))
                {
                    <div id="recovery-error" class="alert alert-danger py-2 mb-3" role="alert" aria-live="polite">@recoveryError</div>
                }

                @if (!string.IsNullOrEmpty(recoverySuccess))
                {
                    <div class="alert alert-success py-2 mb-3" role="status" aria-live="polite">@recoverySuccess</div>
                }
            </div>

            <div class="login-modal-footer">
                <button class="btn btn-secondary" @onclick="ClosePasswordRecovery">@Loc["login.recovery.cancel"]</button>
                <button class="btn login-btn" @onclick="SubmitRecovery" disabled="@isRecoveryLoading">
                    @if (isRecoveryLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>@Loc["login.recovery.sending"]</span>
                    }
                    else
                    {
                        <span>@Loc["login.recovery.sendLink"]</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<style>
    /* ═══════════════════════════════════════════
       LOGIN / REGISTER — shared base
    ═══════════════════════════════════════════ */
    .login-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: fadeIn 0.3s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .login-card {
        position: relative;
        border-radius: var(--radius-lg);
        /* 16px — matches system card tokens */
        padding: 2.75rem 2.25rem 2.25rem;
        width: 100%;
        max-width: 400px;
        animation: slideUp 0.4s ease-out;
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }

    .login-card:hover {
        transform: translateY(-4px);
        box-shadow:
            0 0 18px rgba(255, 122, 0, 0.20),
            0 0 36px rgba(255, 122, 0, 0.12),
            0 16px 40px rgba(0, 0, 0, 0.35);
        border-color: rgba(255, 122, 0, 0.45);
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── X close button ── */
    .login-close-btn {
        position: absolute;
        top: 14px;
        right: 14px;
        width: 30px;
        height: 30px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-sm);
        /* 8px — matches system token */
        border: 1.5px solid var(--accent, #ff7a00);
        background: transparent;
        color: var(--accent, #ff7a00);
        font-size: 0.78rem;
        cursor: pointer;
        transition: box-shadow 0.2s ease, transform 0.15s ease, background 0.2s ease, color 0.2s ease;
        line-height: 1;
    }

    .login-close-btn:hover {
        transform: translateY(-2px);
        box-shadow:
            0 0 12px rgba(255, 122, 0, 0.30),
            0 0 24px rgba(255, 122, 0, 0.15);
        border-color: #ffa040;
        color: #ffa040;
        background: rgba(255, 122, 0, 0.10);
    }

    .login-close-btn:active {
        transform: scale(0.96);
    }

    .login-close-btn:focus-visible {
        outline: 2px solid rgba(27, 119, 210, 0.55);
        outline-offset: 2px;
        box-shadow: 0 0 0 3px rgba(27, 119, 210, 0.12);
    }

    /* ── Brand header ── */
    .login-brand {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        margin-bottom: 1.25rem;
    }

    .login-title {
        font-weight: 700;
        font-size: 1.6rem;
        margin: 0 0 0.15rem;
        color: var(--accent);
        font-family: var(--font-brand, 'Poppins', sans-serif);
    }

    .login-subtitle {
        font-size: 0.85rem;
        margin: 0;
        color: var(--brand-blue);
        /* matches NavMenu brand subtitle */
    }

    .login-heading {
        font-size: 1rem;
        font-weight: 600;
    }

    /* ── CTA register / back-to-login ── */
    .login-cta {
        font-size: 0.83rem;
        margin: 0;
    }

    .login-cta-link {
        color: var(--accent);
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        border: none;
        border-bottom: 1px solid transparent;
        background: none;
        padding: 0;
        font-size: inherit;
        font-family: inherit;
        transition: border-color 0.18s ease, color 0.18s ease;
    }

    .login-cta-link:hover {
        color: #e06c00;
        border-bottom-color: #e06c00;
    }

    .login-cta-link:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
        box-shadow: 0 0 0 4px rgba(255, 122, 0, 0.18);
    }

    .login-optional {
        font-size: 0.75rem;
        font-weight: 400;
        opacity: 0.65;
    }

    /* ── Error Alert with Animation ── */
    .alert-error {
        border: 1px solid rgba(220, 53, 69, 0.3);
        background: rgba(220, 53, 69, 0.08);
        color: var(--state-error);
        border-radius: var(--radius-sm);  /* 8px — matches system token */
        animation: slideDown 0.3s ease-out;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .alert-shake {
        animation: shake 0.5s ease-in-out;
    }

    @@keyframes shake {

        0%,
        100% {
            transform: translateX(0);
        }

        25% {
            transform: translateX(-5px);
        }

        75% {
            transform: translateX(5px);
        }
    }

    /* ── Password Recovery Link ── */
    .login-recovery-link {
        font-size: 0.85rem;
        color: var(--accent);
        font-weight: 500;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        border: none;
        background: none;
        font-family: inherit;
        transition: all 0.2s ease;
        padding: 0.25rem 0.5rem;
        border-radius: var(--radius-sm);  /* 8px — matches system token */
    }

    .login-recovery-link:hover {
        color: #ffa040;
        text-shadow: 0 0 8px rgba(255, 122, 0, 0.4);
        transform: translateX(2px);
    }

    .login-recovery-link:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
        box-shadow: 0 0 0 4px rgba(255, 122, 0, 0.18);
    }

    /* ── Primary button ── */
    .login-btn {
        background: linear-gradient(135deg, var(--accent) 0%, #e06500 100%);
        color: #fff;
        font-weight: 600;
        border: none;
        border-radius: var(--radius-sm);
        /* 8px — matches system .btn */
        padding: 0.65rem;
        font-size: 1rem;
        transition: background 0.22s ease, box-shadow 0.22s ease, transform 0.18s ease;
        box-shadow: 0 4px 14px var(--accent-glow);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .login-btn:hover:not(:disabled) {
        background: linear-gradient(135deg, #ff8f1a 0%, var(--accent) 100%);
        box-shadow: 0 6px 20px var(--accent-glow);
        color: #fff;
        transform: translateY(-2px);
    }

    .login-btn:active:not(:disabled) {
        transform: translateY(0);
        box-shadow: 0 2px 8px var(--accent-glow);
    }

    .login-btn:disabled {
        opacity: 0.45;
        /* matches system .btn:disabled */
        cursor: not-allowed;
        transform: none !important;
        box-shadow: none !important;
    }

    .login-btn .spinner-border {
        width: 1rem;
        height: 1rem;
    }

    /* ── Modal for Password Recovery ── */
    .login-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        animation: fadeIn 0.2s ease-out;
    }

    .login-modal {
        background: inherit;
        border-radius: var(--radius-md);  /* 12px — matches system token */
        width: 100%;
        max-width: 380px;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
        animation: slideUp 0.3s ease-out;
        position: relative;
    }

    .login-modal-close {
        position: absolute;
        top: 12px;
        right: 12px;
        background: transparent;
        border: none;
        color: inherit;
        font-size: 1.2rem;
        cursor: pointer;
        padding: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        border-radius: var(--radius-sm);
        /* 8px — matches system token */
    }

    .login-modal-close:hover {
        background: rgba(255, 122, 0, 0.1);
        color: var(--accent);
    }

    .login-modal-close:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
        box-shadow: 0 0 0 4px rgba(255, 122, 0, 0.18);
    }

    .login-modal-header {
        padding: 2rem 1.75rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-bottom: 1px solid rgba(255, 122, 0, 0.2);
    }

    .login-modal-header i {
        color: var(--accent);
        font-size: 1.5rem;
    }

    .login-modal-header h3 {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 600;
    }

    .login-modal-body {
        padding: 1.75rem;
    }

    .login-modal-footer {
        padding: 1.25rem 1.75rem;
        border-top: 1px solid rgba(255, 122, 0, 0.1);
        display: flex;
        gap: 0.75rem;
        justify-content: flex-end;
    }

    /* ═══════════════════════════════════════════
       DARK THEME
    ═══════════════════════════════════════════ */
    :root.theme-dark .login-wrapper {
        background: #0f1226;
    }

    :root.theme-dark .login-card {
        background: #162041;
        border: 1px solid var(--border-soft);
        box-shadow: 0 8px 40px rgba(0, 0, 0, 0.55);
    }

    :root.theme-dark .login-modal {
        background: #162041;
        border: 1px solid var(--border-soft);
    }

    :root.theme-dark .login-heading {
        color: #cbd5e1;
    }

    /* .login-subtitle dark handled by base rule — var(--brand-blue) */

    :root.theme-dark .login-label {
        color: #94a3b8;
        font-size: 0.875rem;
        font-weight: 500;
    }

