@code {
    // ── Localización ──
    protected override void OnInitialized()
    {
        Loc.OnLanguageChanged += HandleLanguageChanged;
    }

    public void Dispose()
    {
        Loc.OnLanguageChanged -= HandleLanguageChanged;
    }

    private void HandleLanguageChanged()
        => InvokeAsync(StateHasChanged);

    // ── Login state ──
    private string username = "";
    private string password = "";
    private string errorMessage = "";
    private bool isLoading = false;
    private bool showForgotPassword = false;
    private bool showPassword = false; // toggle ver/ocultar contraseña
    private ElementReference usernameInput;
    private ElementReference forgotPasswordBtn;
    private ElementReference recoveryModal;

    // ── Register state ──
    private bool showRegister = false;
    private string regNombre = "";
    private string regApellido = "";
    private string regUsername = "";
    private string regEmail = "";
    private string regPassword = "";
    private string regConfirm = "";
    private string regError = "";
    private string regSuccess = "";
    private bool isRegisterLoading = false;

    // ── Password Recovery state ──
    private bool showPasswordRecoveryModal = false;
    private string recoveryUsername = "";
    private string recoveryError = "";
    private string recoverySuccess = "";
    private bool isRecoveryLoading = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize localization (reads cv_language from localStorage)
            await Loc.InitializeAsync();

            await JS.InvokeVoidAsync("themeManager.applyTheme",
                await JS.InvokeAsync<string>("themeManager.getTheme"));

            // Auto-focus on username field for better UX
            try
            {
                await usernameInput.FocusAsync();
            }
            catch { /* non-critical */ }
        }

        // Wire modal focus trap when it becomes visible
        if (showPasswordRecoveryModal)
        {
            try
            {
                await JS.InvokeVoidAsync("loginAccessibility.open",
                    "recovery-modal", "forgot-password-btn");
            }
            catch { /* non-critical */ }
        }
    }

    // ── LOGIN ──

    private async Task DoLogin()
    {
        // Trim antes de validar — evita falsos negativos por espacios accidentales
        username = username.Trim();
        password = password.Trim();
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = Loc["login.error.fieldsRequired"];
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var user = await AuthSvc.ValidateAsync(username.Trim(), password);

            if (user is null)
            {
                errorMessage = Loc["login.error.invalidCredentials"];
                showForgotPassword = true;
                isLoading = false;
                StateHasChanged();
                return;
            }

            // Login correcto: limpiar estado de error
            errorMessage = "";
            showForgotPassword = false;

            Console.WriteLine($"[Login] Login exitoso para: {user.Username}");

            // Establecer sesión en memoria (AuthStateService es Scoped — vive en el circuito actual)
            AuthStateSvc.Login(user);

            // Guardar nombre de usuario en localStorage SOLO para mostrar en el header
            // NO se usa para autenticación — el auth vive únicamente en memoria
            // Timestamp en ms desde epoch Unix (compatible con Date.now() en JS)
            await JS.InvokeVoidAsync("sessionManager.setUser", new
            {
                id = user.Id,
                username = user.Username,
                email = user.Email ?? string.Empty,
                role = user.Role,
                timestamp = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()
            });

            // Navegación del lado del cliente — mantiene el circuito Blazor activo
            // NO usar forceLoad: true (eso destruiría el circuito y la sesión en memoria)
            Nav.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Login] Error: {ex.Message}");
            errorMessage = Loc["login.error.unexpected"];
            isLoading = false;
            StateHasChanged();
        }
    }

    private void GoHome() => Nav.NavigateTo("/");

    private void TogglePassword() => showPassword = !showPassword;

    // ── REGISTER ──

    private void OpenRegister()
    {
        regError = regSuccess = "";
        regNombre = regApellido = regUsername = regEmail = regPassword = regConfirm = "";
        showForgotPassword = false;
        showRegister = true;
    }

    private void CloseRegister()
    {
        showRegister = false;
        errorMessage = "";
        showForgotPassword = false;
    }

    private async Task DoRegister()
    {
        regError = regSuccess = "";

        if (string.IsNullOrWhiteSpace(regNombre))
        {
            regError = Loc["register.error.firstNameRequired"];
            return;
        }

        if (string.IsNullOrWhiteSpace(regApellido))
        {
            regError = Loc["register.error.lastNameRequired"];
            return;
        }

        if (string.IsNullOrWhiteSpace(regUsername) || string.IsNullOrWhiteSpace(regPassword))
        {
            regError = Loc["register.error.fieldsRequired"];
            return;
        }

        if (regPassword != regConfirm)
        {
            regError = Loc["register.error.passwordMismatch"];
            return;
        }

        if (regPassword.Length < 6)
        {
            regError = Loc["register.error.passwordTooShort"];
            return;
        }

        isRegisterLoading = true;
        StateHasChanged();

        try
        {
            var (ok, error) = await AuthSvc.RegisterAsync(
                regUsername.Trim(), regPassword, regEmail,
                regNombre.Trim(), regApellido.Trim());

            if (!ok)
            {
                regError = error;
                isRegisterLoading = false;
                StateHasChanged();
                return;
            }

            regSuccess = Loc["register.success"];
            StateHasChanged();
            await Task.Delay(900);

            // Usar ValidateAsync para obtener el usuario con su ID real (evita id=0)
            var newUser = await AuthSvc.ValidateAsync(regUsername.Trim(), regPassword);
            if (newUser is not null)
            {
                Console.WriteLine($"[Login] Registro exitoso para: {newUser.Username} (Id={newUser.Id})");

                // Establecer sesión en memoria
                AuthStateSvc.Login(newUser);

                // Guardar en localStorage SOLO para display en header
                await JS.InvokeVoidAsync("sessionManager.setUser", new
                {
                    id = newUser.Id,
                    username = newUser.Username,
                    email = newUser.Email ?? string.Empty,
                    role = newUser.Role,
                    timestamp = DateTime.UtcNow.Ticks
                });
            }

            // Navegación del lado del cliente — mantiene el circuito y la sesión en memoria
            Nav.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Login] Error en registro: {ex.Message}");
            regError = "Error durante el registro. Intentá de nuevo.";
            isRegisterLoading = false;
            StateHasChanged();
        }
    }

    // ── PASSWORD RECOVERY ──

    private void OpenPasswordRecovery()
    {
        recoveryUsername = "";
        recoveryError = "";
        recoverySuccess = "";
        showPasswordRecoveryModal = true;
    }

    private async Task ClosePasswordRecovery()
    {
        await JS.InvokeVoidAsync("loginAccessibility.close");
        showPasswordRecoveryModal = false;
    }

    private async Task SubmitRecovery()
    {
        recoveryError = "";
        recoverySuccess = "";

        if (string.IsNullOrWhiteSpace(recoveryUsername))
        {
            recoveryError = Loc["login.recovery.errorUsernameRequired"];
            return;
        }

        isRecoveryLoading = true;
        StateHasChanged();

        await Task.Delay(1000); // Simulate API call

        recoverySuccess = Loc["login.recovery.success"];
        isRecoveryLoading = false;
        StateHasChanged();

        await Task.Delay(2500);
        ClosePasswordRecovery();
    }
}
