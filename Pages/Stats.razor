@page "/stats"
@inject CryptoApiService ApiService
@using Microsoft.EntityFrameworkCore
@inject CryptoDbContext DbContext
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Estadísticas - CryptoView</PageTitle>
@inject CryptoView.Services.AuthStateService AuthStateSvc
@inject NavigationManager Nav

<div class="page-container stats-container stats-page printable-report">
    <!-- Header -->
    <div class="page-header mb-4">
        <h1 class="display-5 fw-bold text-warning mb-1">Estadísticas de Criptomonedas</h1>
        <p class="lead text-light mb-0">Comparación y análisis estadístico de criptomonedas</p>
    </div>

    <!-- Panel de comparación (siempre visible) -->
    <div class="comparison-panel stats-card mb-4" role="region" aria-label="Panel de comparación de criptomonedas">
        <div class="comparison-panel-header">
            <div>
                <h4 class="text-warning mb-1">
                    <i class="bi bi-bar-chart-steps"></i> Selección de monedas para comparar
                </h4>
                <p class="text-muted small mb-0">Seleccioná 2 o más monedas y un período para comparar precios.</p>
            </div>
        </div>
        <div class="comparison-panel-body">
            <div class="coin-chips-container mb-3" role="group" aria-label="Monedas disponibles para comparar">
                @foreach (var coin in GetAvailableComparisonCoins())
                {
                    var sym = coin.Symbol;
                    var coinName = coin.Name;
                    var isChipSelected = selectedCoins.Contains(sym);
                    var ariaPressed = isChipSelected ? "true" : "false";
                    var chipClass = isChipSelected ? "coin-chip selected" : "coin-chip";
                    <button class="@chipClass" @onclick="() => ToggleCoinSelection(sym)" aria-pressed="@ariaPressed"
                            aria-label="@coinName">
                        <span class="coin-chip-symbol">@sym</span>
                        <span class="coin-chip-name">@coinName</span>
                    </button>
                }
            </div>
            <!-- Período de análisis (MOBILE) -->
            <div class="period-block d-md-none mb-4">
                <div class="period-block-title">📅 Período de análisis</div>
                <div class="filter-group">
                    <label class="period-label">Fecha inicial</label>
                    <div class="cv-datepicker-wrap">
                        <input class="filter-input" id="fp-compareFrom" placeholder="dd/MM/yyyy"
                               aria-label="Fecha inicial" />
                        <i class="bi bi-calendar3 cv-datepicker-icon"></i>
                    </div>
                    <span id="fp-compareFrom-error" class="cv-date-error"></span>
                </div>
                <div class="filter-group">
                    <label class="period-label">Fecha final</label>
                    <div class="cv-datepicker-wrap">
                        <input class="filter-input" id="fp-compareTo" placeholder="dd/MM/yyyy"
                               aria-label="Fecha final" />
                        <i class="bi bi-calendar3 cv-datepicker-icon"></i>
                    </div>
                    <span id="fp-compareTo-error" class="cv-date-error"></span>
                </div>
                <button class="comparison-btn-compare w-100 mt-1" @onclick="OnCompareClicked" disabled="@isComparing"
                        aria-label="Comparar monedas seleccionadas">
                    @if (isComparing)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        @:Comparando...
                    }
                    else
                    {
                        <i class="bi bi-bar-chart"></i>@: Comparar
                    }
                </button>
            </div>

            <!-- Período de análisis (DESKTOP) -->
            <div class="comparison-period-row d-none d-md-flex flex-wrap align-items-end gap-3 mb-3">
                <span class="comparison-row-label">Período</span>
                <div class="filter-group">
                    <label class="filter-label">Desde</label>
                    <div class="cv-datepicker-wrap">
                        <input class="filter-input" id="fp-compareFrom-desktop" placeholder="dd/MM/yyyy"
                               aria-label="Fecha desde" />
                        <i class="bi bi-calendar3 cv-datepicker-icon"></i>
                    </div>
                    <span id="fp-compareFrom-desktop-error" class="cv-date-error"></span>
                </div>
                <div class="filter-group">
                    <label class="filter-label">Hasta</label>
                    <div class="cv-datepicker-wrap">
                        <input class="filter-input" id="fp-compareTo-desktop" placeholder="dd/MM/yyyy"
                               aria-label="Fecha hasta" />
                        <i class="bi bi-calendar3 cv-datepicker-icon"></i>
                    </div>
                    <span id="fp-compareTo-desktop-error" class="cv-date-error"></span>
                </div>
            </div>
            <div class="comparison-actions">
                <div class="comparison-actions-right">
                    <button class="comparison-btn-clear" @onclick="ClearComparison" aria-label="Limpiar selección">
                        <i class="bi bi-x-circle"></i> Limpiar
                    </button>
                    <button class="comparison-btn-compare" @onclick="OnCompareClicked" disabled="@isComparing"
                            aria-label="Comparar monedas seleccionadas">
                        @if (isComparing)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            @:Comparando...
                        }
                        else
                        {
                            <i class="bi bi-bar-chart-steps"></i>
                            @:Comparar
                        }
                    </button>
                    @if (hasCompared && !lineChartEmpty)
                    {
                        <button class="cv-download-chart-btn"
                                @onclick='async () => await JSRuntime.InvokeVoidAsync("cvDownloadChart", "lineChart", "comparacion-cryptoview.png")'
                                title="Descargar gráfico como PNG">
                            <i class="bi bi-download"></i> Descargar
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (filterError != null)
    {
        <div class="filter-error mt-2 mb-3">
            <i class="bi bi-exclamation-circle"></i> @filterError
        </div>
    }

    @if (coinWarnings.Any())
    {
        <div class="mt-2 mb-3">
            @foreach (var kv in coinWarnings)
            {
                <div class="alert alert-warning py-2 px-3 mb-1 d-flex align-items-center gap-2" style="font-size:.88rem;">
                    <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                    <span><strong>@kv.Key</strong>: @kv.Value</span>
                </div>
            }
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-warning" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-light">Cargando datos...</p>
        </div>
    }
    else
    {
        <!-- chart content below -->
    }

    <div class="stats-sections @(!isLoading ? "" : "d-none")">
        <!-- Analytics Cards: precio inicial, final, máx, mín, variación %, vol. promedio -->
        @if (showLineChart && analyticsInitialPrice.HasValue)
        {
            <div class="row analytics-cards-row">
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="analytics-card stats-card">
                        <span class="analytics-label">Precio inicial</span>
                        <span class="analytics-value">@FormatPrice(analyticsInitialPrice.Value)</span>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="analytics-card stats-card">
                        <span class="analytics-label">Precio final</span>
                        <span class="analytics-value">@FormatPrice(analyticsFinalPrice!.Value)</span>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="analytics-card stats-card">
                        <span class="analytics-label">Máximo del período</span>
                        <span class="analytics-value analytics-up">@FormatPrice(analyticsMaxPrice!.Value)</span>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="analytics-card stats-card">
                        <span class="analytics-label">Mínimo del período</span>
                        <span class="analytics-value analytics-down">@FormatPrice(analyticsMinPrice!.Value)</span>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="analytics-card stats-card">
                        <span class="analytics-label">Variación %</span>
                        <span class="analytics-value @(analyticsPctChange >= 0 ? "analytics-up" : "analytics-down")">
                            @(analyticsPctChange >= 0 ? "+" : "")@analyticsPctChange!.Value.ToString("F2")%
                        </span>
                    </div>
                </div>
                @if (analyticsAvgVolume.HasValue)
                {
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="analytics-card stats-card">
                            <span class="analytics-label">Vol. promedio</span>
                            <span class="analytics-value">$@FormatLargeNumber(analyticsAvgVolume.Value)</span>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="row">
            <div class="col-12">
                <div
                    class="chart-card stats-card chart-fade-anim @(hasCompared ? "cv-comparison-card" : "") cv-main-chart-card">
                    <div class="chart-header">
                        <div>
                            <h3 class="text-warning">
                                <i class="bi bi-graph-up"></i> @lineChartTitle
                            </h3>
                            <p class="text-muted mb-0">@lineChartSubtitle</p>
                        </div>
                        @if (hasCompared && selectedCoins.Count >= 1 && !lineChartEmpty)
                        {
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                @if (selectedCoins.Count >= 2)
                                {
                                    <div class="chart-mode-toggle">
                                        <button class="chart-mode-btn @(chartMode == "percent" ? "active" : "")"
                                                @onclick='() => SwitchChartMode("percent")'>
                                            <i class="bi bi-percent"></i> Rendimiento
                                        </button>
                                        <button class="chart-mode-btn @(chartMode == "price" ? "active" : "")"
                                                @onclick='() => SwitchChartMode("price")'>
                                            <i class="bi bi-currency-dollar"></i> Precio USD
                                        </button>
                                    </div>
                                }
                                <button class="cv-reset-zoom-btn"
                                        @onclick='async () => await JSRuntime.InvokeVoidAsync("cvResetZoom", "lineChart")'
                                        title="Restablecer zoom al estado inicial">
                                    <i class="bi bi-arrows-fullscreen"></i> Reset zoom
                                </button>
                            </div>
                        }
                    </div>
                    <div class="chart-wrapper">
                        <canvas id="lineChart" style="@(showLineChart ? "" : "display:none;")"></canvas>
                        @if (!showLineChart && chartApiError != null)
                        {
                            <div class="stats-empty-state">
                                <div class="stats-empty-icon"><i class="bi bi-wifi-off"></i></div>
                                <p class="stats-empty-title">Error al consultar CoinGecko</p>
                                <p class="stats-empty-sub">@chartApiError</p>
                            </div>
                        }
                        else if (!showLineChart && lineChartEmpty)
                        {
                            <div class="stats-empty-state">
                                <div class="stats-empty-icon"><i class="bi bi-calendar-x"></i></div>
                                <p class="stats-empty-title">Sin datos en ese rango</p>
                                <p class="stats-empty-sub">No hay datos disponibles para la moneda y fechas seleccionadas.
                                    Probá con otro rango.</p>
                                </div>
                            }
                        else if (!showLineChart && selectedCoins.Count > 0 && !hasCompared)
                            {
                                <div class="stats-empty-state">
                                    <div class="stats-empty-icon"><i class="bi bi-bar-chart-steps"></i></div>
                                    <p class="stats-empty-title">@selectedCoins.Count moneda@(selectedCoins.Count == 1 ? "" :
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              "s") seleccionada@(selectedCoins.Count == 1 ? "" : "s")</p>
                                        <p class="stats-empty-sub">Completá el período y presioná Comparar.</p>
                                    </div>
                                }
                        else if (!showLineChart)
                                {
                                    <div class="stats-empty-state">
                                        <div class="stats-empty-icon"><i class="bi bi-graph-up-arrow"></i></div>
                                        <p class="stats-empty-title">Compará criptomonedas</p>
                                        <p class="stats-empty-sub">Seleccioná 2 o más monedas, completá el período y presioná
                                            Comparar.</p>
                                        </div>
                                    }
                                </div>
                                @if (showLineChart)
                                {
                                    <p class="chart-caption px-2">
                                        @if (hasCompared && selectedCoins.Count > 1)
                                        {
                                            <span>Este gráfico facilita la <strong>comparación visual</strong> del comportamiento de
                                                <strong>@selectedCoins.Count criptomonedas</strong> a lo largo del tiempo.</span>
                                            }
                            else
                                            {
                                                <span>Gráfico lineal del <strong>precio histórico</strong> en el período seleccionado.</span>
                                            }
                                        </p>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- ═══ Wide Stats Cards — Power BI Style ═══ -->
                        <div class="stats-info-section">

                            <!-- 1. Interpretación educativa -->
                            <div class="stats-wide-card stats-card">
                                <h3><i class="bi bi-info-circle"></i> Interpretación Educativa</h3>
                                <div class="stats-explain-grid">
                                    <div class="stats-explain-item">
                                        <strong>Media (Promedio):</strong> Es el valor central de los precios en el período. Suma todos
                                        los precios y los divide por la cantidad de datos.
                                    </div>
                                    <div class="stats-explain-item">
                                        <strong>Mediana:</strong> Es el valor que está justo en el medio cuando se ordenan todos los
                                        precios. No se ve afectada por valores extremos.
                                    </div>
                                    <div class="stats-explain-item">
                                        <strong>Desviación Estándar:</strong> Mide qué tan dispersos están los precios respecto a la
                                        media. Un valor alto indica alta volatilidad.
                                    </div>
                                    <div class="stats-explain-item">
                                        <strong>Volumen 24h:</strong> Cantidad total de dinero negociado en las últimas 24 horas. Indica
                                        el interés y liquidez del activo.
                                    </div>
                                    <div class="stats-explain-item">
                                        <strong>Market Cap:</strong> Capitalización de mercado = Precio × Oferta circulante. Refleja el
                                        valor total del activo en el mercado.
                                    </div>
                                    <div class="stats-explain-item">
                                        <strong>Cambio 24h:</strong> Variación porcentual del precio en las últimas 24 horas. Verde =
                                        subió, Rojo = bajó.
                                    </div>
                                </div>
                                <p class="text-warning mt-3 mb-0">
                                    <i class="bi bi-exclamation-triangle"></i>
                                    <strong>Nota Educativa:</strong> Los datos históricos son simulados con perfiles realistas. Los
                                    precios actuales y market cap provienen de la API de Coinlore.
                                </p>
                            </div>

                            <!-- 2. Resumen comparativo -->
                            <div class="stats-wide-card stats-card">
                                <h3><i class="bi bi-bar-chart-steps"></i> Resumen Comparativo</h3>
                                <div class="stats-metrics-grid">
                                    <div class="stats-metric-item">
                                        <span class="stats-metric-label">Total monedas comparadas</span>
                                        <span class="stats-metric-value">@(hasCompared ? selectedCoins.Count : cryptos.Count)</span>
                                    </div>
                                    <div class="stats-metric-item">
                                        <span class="stats-metric-label">Mayor suba 24h</span>
                                        <span class="stats-metric-value analytics-up">@GetStatsTopGainer()</span>
                                    </div>
                                    <div class="stats-metric-item">
                                        <span class="stats-metric-label">Mayor baja 24h</span>
                                        <span class="stats-metric-value analytics-down">@GetStatsTopLoser()</span>
                                    </div>
                                    <div class="stats-metric-item">
                                        <span class="stats-metric-label">Mejor rendimiento prom.</span>
                                        <span class="stats-metric-value analytics-up">@GetStatsBestAvg()</span>
                                    </div>
                                    <div class="stats-metric-item">
                                        <span class="stats-metric-label">Peor rendimiento prom.</span>
                                        <span class="stats-metric-value analytics-down">@GetStatsWorstAvg()</span>
                                    </div>
                                    <div class="stats-metric-item">
                                        <span class="stats-metric-label">Cambio promedio 24h</span>
                                        <span class="stats-metric-value">@((cryptos.Any() ? cryptos.Average(c => c.Change24h) :
                                                                                                                                                                                                                                                                                                                                                                                                                                        0).ToString("F2"))%</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- 3. Análisis estadístico -->
                                <div class="stats-wide-card stats-card">
                                    <h3><i class="bi bi-calculator"></i> Análisis Estadístico</h3>
                                    @{
                                        var statsForDisplay = GetStatsForDisplay();
                                    }
                                    @if (statsForDisplay.Any())
                                    {
                                        <div class="stats-metrics-grid">
                                            @foreach (var metric in statsForDisplay)
                                            {
                                                <div class="stats-metric-item">
                                                    <span class="stats-metric-label">@metric.Label</span>
                                                    <span class="stats-metric-value @metric.ValueClass">@metric.Value</span>
                                                </div>
                                            }
                                        </div>
                                        @if (hasCompared && selectedCoins.Count > 1)
                                        {
                                            <p class="stats-note mt-3">
                                                <i class="bi bi-info-circle"></i>
                                                Métricas calculadas sobre el conjunto de las @selectedCoins.Count criptomonedas seleccionadas.
                                            </p>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-muted">Seleccioná monedas y un período para ver estadísticas detalladas.</p>
                                    }
                                </div>


                            </div>

                            <!-- Portfolio Analysis -->
                            @if (cryptos.Any())
                            {
                                <div class="row">
                                    <div class="col-md-6">
                                        @if (pieKpiMode && hasCompared)
                                        {
                                            var kpiSym = selectedCoins.FirstOrDefault() ?? "";
                                            decimal kpiToday = 0m, kpiYesterday = 0m;
                                            if (marketCapData.TryGetValue(kpiSym, out var kpiMc))
                                            {
                                                kpiToday = kpiMc.Today;
                                                kpiYesterday = kpiMc.Yesterday;
                                            }
                                            var kpiChangePct = kpiToday > 0 && kpiYesterday > 0
                                                ? (kpiToday - kpiYesterday) / kpiYesterday * 100m : 0m;
                                            var kpiCoinName = GetAvailableComparisonCoins()
                                                .Where(c => c.Symbol.Equals(kpiSym, StringComparison.OrdinalIgnoreCase))
                                                .Select(c => c.Name).FirstOrDefault() ?? kpiSym;
                                            var kpiDirectionClass = kpiChangePct >= 0 ? "kpi-up" : "kpi-down";
                                            var kpiCircleIcon = kpiChangePct >= 0 ? "bi-arrow-up-circle-fill" : "bi-arrow-down-circle-fill";
                                            var kpiBadgeClass = kpiChangePct >= 0 ? "badge-up" : "badge-down";
                                            var kpiArrowIcon = kpiChangePct >= 0 ? "bi-arrow-up" : "bi-arrow-down";
                                            <div class="chart-card stats-card d-flex flex-column">
                                                <div class="chart-header">
                                                    <h3 class="text-warning">
                                                        <i class="bi bi-bar-chart"></i> Market Cap — @kpiCoinName
                                                    </h3>
                                                    <p class="text-muted mb-0">Selecció 2 o más monedas para ver la distribución comparativa.
                                                    </p>
                                                </div>
                                                <div class="d-flex flex-column align-items-center justify-content-center flex-grow-1 gap-3 py-3">
                                                    <div class="kpi-row">
                                                        <div class="kpi-card kpi-today stats-card">
                                                            <span class="kpi-label">Hoy</span>
                                                            <span class="kpi-value">$@FormatLargeNumber(kpiToday)</span>
                                                        </div>
                                                        <div class="kpi-arrow @kpiDirectionClass">
                                                            <i class="bi @kpiCircleIcon"></i>
                                                        </div>
                                                        <div class="kpi-card kpi-yesterday stats-card">
                                                            <span class="kpi-label">Ayer</span>
                                                            <span class="kpi-value">$@FormatLargeNumber(kpiYesterday)</span>
                                                        </div>
                                                    </div>
                                                    <div class="kpi-change-badge @kpiBadgeClass">
                                                        <i class="bi @kpiArrowIcon"></i>
                                                        @Math.Abs(kpiChangePct).ToString("F2")%
                                                    </div>
                                                    <p class="text-muted small text-center mb-0">
                                                        <i class="bi bi-info-circle"></i>
                                                        Capitaliz. de mercado hoy vs ayer. Selecció 2+ monedas para distribución comparativa.
                                                    </p>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="chart-card stats-card">
                                                <div class="chart-header">
                                                    <h3 class="text-warning">
                                                        <i class="bi bi-pie-chart"></i> Distribución de Market Cap
                                                    </h3>
                                                    <p class="text-muted mb-0">
                                                        @if (selectedCoins.Count == 0)
                                                        {
                                                            <span>Seleccioná al menos una moneda para ver la distribución de market cap</span>
                                                        }
                                                        else if (hasCompared && selectedCoins.Count == 1)
                                                        {
                                                            <span>Agregá otra moneda para comparar la distribución</span>
                                                        }
                                                        else if (hasCompared)
                                                        {
                                                            <span>Capitalización de mercado comparada entre las monedas seleccionadas</span>
                                                        }
                                                        else
                                                        {
                                                            <span>Proporción relativa de capitalización de mercado del portfolio</span>
                                                        }
                                                    </p>
                                                </div>
                                                <div class="chart-body">
                                                    <canvas id="pieChart"></canvas>
                                                    <p class="chart-description">Este gráfico muestra qué <strong>porcentaje del valor total del
                                                        mercado</strong> representa cada criptomoneda seleccionada.</p>
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <div class="col-md-6">
                                            <div class="chart-card stats-card">
                                                <div class="chart-header">
                                                    <h3 class="text-warning">
                                                        <i class="bi bi-bar-chart"></i> Cambios de Precio 24h
                                                    </h3>
                                                    <p class="text-muted mb-0">
                                                        @if (selectedCoins.Count == 0)
                                                        {
                                                            <span>Seleccioná al menos una moneda para ver los cambios de precio</span>
                                                        }
                                                        else if (hasCompared && selectedCoins.Count == 1)
                                                        {
                                                            <span>Agregá otra moneda para comparar los cambios de precio</span>
                                                        }
                                                        else
                                                        {
                                                            <span>Variación de precio en las últimas 24h por moneda. Verde = subida,
                                                                Rojo = caída.</span>
                                                            }
                                                        </p>
                                                    </div>
                                                    <div class="chart-body">
                                                        <canvas id="barChart"></canvas>
                                                        <p class="chart-description">Este gráfico compara la <strong>variación porcentual del
                                                            precio</strong> de cada criptomoneda durante las <strong>últimas 24 horas</strong>.
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Portfolio Summary -->
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="stat-summary-card stats-card">
                                                    <h4 class="text-warning mb-1">
                                                        <i class="bi bi-list-check"></i> Resumen del Portfolio
                                                        @if (hasCompared && selectedCoins.Any())
                                                        {
                                                            <span class="text-muted fs-6 fw-normal ms-2">(@selectedCoins.Count
                                                                moneda@(selectedCoins.Count == 1 ? "" : "s"))</span>
                                                            }
                                    else
                                                            {
                                                                <span class="text-muted fs-6 fw-normal ms-2">(@cryptos.Count moneda@(cryptos.Count == 1 ? "" :
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "s"))</span>
                                                                }
                                                            </h4>
                                                            <p class="chart-description mb-3" style="text-align:left;">
                                                                @if (hasCompared && selectedCoins.Count > 1)
                                                                {
                                                                    <span>Precio actual, capitalización de mercado y variación diaria de cada activo
                                                                        seleccionado.</span>
                                                                    }
                                    else
                                                                    {
                                                                        <span>Esta sección resume el <strong>precio actual</strong>, la <strong>capitalización de
                                                                            mercado</strong> y la <strong>variación diaria</strong> de cada activo.</span>
                                                                        }
                                                                    </p>
                                                                    @if (hasCompared && selectedCoins.Any())
                                                                    {
                                                                        // Modo comparación: iterar directamente sobre selectedCoins sin depender de la BD.
                                                                        // Esto garantiza que se muestre 1 card por cada moneda seleccionada,
                                                                        // incluso si la moneda no está guardada en la base de datos local.
                                                                        var comparisonCoins = GetAvailableComparisonCoins().ToList();
                                                                        var orderedSelected = selectedCoins
                                                                            .OrderByDescending(s => marketCapData.TryGetValue(s.ToUpper(), out var mc2) ? mc2.Today : 0m)
                                                                            .ToList();
                                                                        Console.WriteLine($"[Portfolio] Monedas seleccionadas: {selectedCoins.Count} | Cargadas:                    {orderedSelected.Count}");
                                                                        foreach (var s2 in orderedSelected)
                                                                            Console.WriteLine($"[Portfolio] Moneda: {s2}");
                                                                        <div class="portfolio-summary-grid">
                                                                            @foreach (var sym in orderedSelected)
                                                                            {
                                                                                var symUpper = sym.ToUpper();
                                                                                var dbCoin = cryptos.FirstOrDefault(c => c.Symbol.Equals(sym,
                                                                StringComparison.OrdinalIgnoreCase));
                                                                                var coinMeta = comparisonCoins.FirstOrDefault(c => c.Symbol.Equals(symUpper,
                                                                StringComparison.OrdinalIgnoreCase));
                                                                                var coinName = dbCoin?.Name ?? (coinMeta.Symbol != null ? coinMeta.Name : symUpper);
                                                                                var change = change24hData.TryGetValue(symUpper, out var ch24) ? ch24 : (dbCoin?.Change24h
                                                                ?? 0m);
                                                                                var cap = marketCapData.TryGetValue(symUpper, out var mcVal) ? mcVal.Today :
                                                                (dbCoin?.MarketCap ?? 0m);
                                                                                var price = dbCoin?.CurrentPrice ?? 0m;
                                                                                <div class="portfolio-card stats-card" @key="symUpper">
                                                                                    <div class="portfolio-card-header">
                                                                                        <div class="portfolio-coin-info">
                                                                                            <span class="portfolio-coin-name">@coinName</span>
                                                                                            <span class="portfolio-coin-symbol">@symUpper</span>
                                                                                        </div>
                                                                                        <span class="badge @(change >= 0 ? "bg-success" : "bg-danger") portfolio-badge">
                                                                                            @(change >= 0 ? "+" : "")@change.ToString("F2")%
                                                                                        </span>
                                                                                    </div>
                                                                                    <div class="portfolio-card-body">
                                                                                        <div class="portfolio-data-row">
                                                                                            <span class="portfolio-data-label">Precio</span>
                                                                                            <span class="portfolio-data-value">$@price.ToString("N2")</span>
                                                                                        </div>
                                                                                        <div class="portfolio-data-row">
                                                                                            <span class="portfolio-data-label">Market Cap</span>
                                                                                            <span class="portfolio-data-value">$@FormatLargeNumber(cap)</span>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            }
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        var portfolioCoins = cryptos
                                                                            .OrderByDescending(c => c.MarketCap)
                                                                            .ToList();
                                                                        Console.WriteLine($"[Portfolio] Modo portfolio: {portfolioCoins.Count} monedas");
                                                                        <div class="portfolio-summary-grid">
                                                                            @foreach (var crypto in portfolioCoins)
                                                                            {
                                                                                <div class="portfolio-card stats-card" @key="crypto.Symbol">
                                                                                    <div class="portfolio-card-header">
                                                                                        <div class="portfolio-coin-info">
                                                                                            <span class="portfolio-coin-name">@crypto.Name</span>
                                                                                            <span class="portfolio-coin-symbol">@crypto.Symbol.ToUpper()</span>
                                                                                        </div>
                                                                                        <span
                                                                                            class="badge @(crypto.Change24h >= 0 ? "bg-success" : "bg-danger") portfolio-badge">
                                                                                            @(crypto.Change24h >= 0 ? "+" : "")@crypto.Change24h.ToString("F2")%
                                                                                        </span>
                                                                                    </div>
                                                                                    <div class="portfolio-card-body">
                                                                                        <div class="portfolio-data-row">
                                                                                            <span class="portfolio-data-label">Precio</span>
                                                                                            <span class="portfolio-data-value">$@crypto.CurrentPrice.ToString("N2")</span>
                                                                                        </div>
                                                                                        <div class="portfolio-data-row">
                                                                                            <span class="portfolio-data-label">Market Cap</span>
                                                                                            <span class="portfolio-data-value">$@FormatLargeNumber(crypto.MarketCap)</span>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            }
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                                            else
                                                    {
                                                        <div class="stats-empty-state stats-empty-full">
                                                            <div class="stats-empty-icon">
                                                                <i class="bi bi-coin"></i>
                                                            </div>
                                                            <p class="stats-empty-title">No hay datos de portfolio</p>
                                                            <p class="stats-empty-sub">Agregá criptomonedas a tu portfolio para ver estadísticas y gráficos
                                                                históricos.</p>
                                                                <a href="/cryptolist" class="stats-empty-cta">
                                                                    <i class="bi bi-plus-circle"></i> Agregar Criptomonedas
                                                                </a>
                                                            </div>
                                                        }
                                                    </div>
