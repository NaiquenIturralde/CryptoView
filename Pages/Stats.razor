@code {

    private List<CryptoCurrency> cryptos = new();
    private List<HistoricalPriceData> historicalData = new();
    private bool isLoading = true;
    private bool _chartsRendered = false;

    // Analytics cards (precio inicial, final, máx, mín, variación %, vol. promedio)
    private decimal? analyticsInitialPrice = null;
    private decimal? analyticsFinalPrice = null;
    private decimal? analyticsMaxPrice = null;
    private decimal? analyticsMinPrice = null;
    private decimal? analyticsPctChange = null;
    private decimal? analyticsAvgVolume = null;
    private string? chartApiError = null;

    // Dynamic chart labels
    private string lineChartTitle = "Evolución histórica de precios";
    private string lineChartSubtitle = "Seleccioná monedas y un período para comparar";
    private string selectedCoinName = "Bitcoin";
    private bool lineChartEmpty = false;
    private bool showLineChart = false;
    private string chartMode = "percent"; // "percent" | "price"

    // ── Comparison state ──────────────────────────────────────────────────────
    private bool isComparing = false;
    private bool hasCompared = false;
    private bool pieKpiMode = false;
    private List<string> selectedCoins = new();
    private DateTime? compareFrom = null;
    private DateTime? compareTo = null;
    private Dictionary<string, List<HistoricalPriceData>> multiHistoricalData = new();
    private Dictionary<string, (decimal Today, decimal Yesterday)> marketCapData = new();
    private Dictionary<string, decimal> change24hData = new();
    private Dictionary<string, string> coinWarnings = new(); // advertencias por moneda
    private string? filterError = null;

    private static readonly List<(string Symbol, string Name)> _staticComparisonCoins = new()
    {
        ("BTC", "Bitcoin"),
        ("ETH", "Ethereum"),
        ("BNB", "BNB"),
        ("SOL", "Solana"),
        ("ADA", "Cardano"),
        ("XRP", "XRP"),
    };

    protected override async Task OnInitializedAsync()
    {
        if (!AuthStateSvc.IsAuthenticated())
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }
        await LoadData();
    }

    private DotNetObjectReference<Stats>? _dotNetRef;
    private readonly HashSet<string> _initializedPickers = new();
    private static readonly string[] _pickerIds =
    {
        "fp-compareFrom",
        "fp-compareTo",
        "fp-compareFrom-desktop",
        "fp-compareTo-desktop"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isLoading && !_chartsRendered)
        {
            _chartsRendered = true;
            await RenderCharts();
        }

        if (!isLoading)
        {
            await InitDatePickersAsync();
        }
    }

    private async Task InitDatePickersAsync()
    {
        _dotNetRef ??= DotNetObjectReference.Create(this);

        if (_initializedPickers.Add("fp-compareFrom"))
            await JSRuntime.InvokeVoidAsync("cvDatePicker.init", "fp-compareFrom", _dotNetRef, "SetCompareFrom",
                compareFrom?.ToString("yyyy-MM-dd"));
        if (_initializedPickers.Add("fp-compareTo"))
            await JSRuntime.InvokeVoidAsync("cvDatePicker.init", "fp-compareTo", _dotNetRef, "SetCompareTo",
                compareTo?.ToString("yyyy-MM-dd"));
        if (_initializedPickers.Add("fp-compareFrom-desktop"))
            await JSRuntime.InvokeVoidAsync("cvDatePicker.init", "fp-compareFrom-desktop", _dotNetRef, "SetCompareFrom",
                compareFrom?.ToString("yyyy-MM-dd"));
        if (_initializedPickers.Add("fp-compareTo-desktop"))
            await JSRuntime.InvokeVoidAsync("cvDatePicker.init", "fp-compareTo-desktop", _dotNetRef, "SetCompareTo",
                compareTo?.ToString("yyyy-MM-dd"));
    }

    [JSInvokable]
    public void SetCompareFrom(string dateStr)
    {
        if (string.IsNullOrEmpty(dateStr))
            compareFrom = null;
        else if (DateTime.TryParse(dateStr, out var parsed))
            compareFrom = parsed > DateTime.Today ? DateTime.Today : parsed;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void SetCompareTo(string dateStr)
    {
        if (string.IsNullOrEmpty(dateStr))
            compareTo = null;
        else if (DateTime.TryParse(dateStr, out var parsed))
            compareTo = parsed > DateTime.Today ? DateTime.Today : parsed;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            cryptos = await DbContext.CryptoCurrencies
                .Where(c => c.IsActive)
                .OrderByDescending(c => c.MarketCap)
                .ToListAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RenderCharts()
    {
        try
        {
            if (cryptos.Any())
            {
                var cryptoNames = cryptos.Select(c => c.Name).ToArray();
                var marketCaps = cryptos.Select(c => (double)c.MarketCap).ToArray();
                var symbols = cryptos.Select(c => c.Symbol.ToUpper()).ToArray();
                var changes = cryptos.Select(c => (double)c.Change24h).ToArray();
                await JSRuntime.InvokeVoidAsync("renderPieChart", "pieChart", cryptoNames, marketCaps);
                await JSRuntime.InvokeVoidAsync("renderBarChart", "barChart", symbols, changes);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rendering charts: {ex.Message}");
        }
    }

    private string FormatLargeNumber(decimal number)
    {
        if (number >= 1_000_000_000)
            return $"{(number / 1_000_000_000):F2}B";
        if (number >= 1_000_000)
            return $"{(number / 1_000_000):F2}M";
        if (number >= 1_000)
            return $"{(number / 1_000):F2}K";
        return number.ToString("N2");
    }

