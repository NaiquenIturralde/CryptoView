    private string GetStatsTopGainer()
    {
        if (!cryptos.Any()) return "-";
        var top = cryptos.OrderByDescending(c => c.Change24h).First();
        return $"{top.Symbol.ToUpper()} +{top.Change24h:F2}%";
    }

    private string GetStatsTopLoser()
    {
        if (!cryptos.Any()) return "-";
        var bottom = cryptos.OrderBy(c => c.Change24h).First();
        return $"{bottom.Symbol.ToUpper()} {bottom.Change24h:F2}%";
    }

    private string GetStatsBestAvg()
    {
        if (!cryptos.Any()) return "-";
        var avg = cryptos.Average(c => c.Change24h);
        return $"{avg:F2}%";
    }

    private string GetStatsWorstAvg()
    {
        if (!cryptos.Any()) return "-";
        var avg = cryptos.Average(c => c.Change24h);
        return $"{avg:F2}%";
    }

    private List<(string Label, string Value, string ValueClass)> GetStatsForDisplay()
    {
        var result = new List<(string, string, string)>();
        var isComp = hasCompared && selectedCoins.Count > 1 && multiHistoricalData.Any();
        var data = isComp
            ? multiHistoricalData.SelectMany(kv => kv.Value).ToList()
            : new List<HistoricalPriceData>();

        if (!data.Any()) return result;

        var prices = data.Select(d => d.Price).ToList();
        var stats = ApiService.CalculateStatistics(prices);
        var cv = stats.Mean > 0 ? stats.StdDev / stats.Mean * 100m : 0m;

        // Median
        var sorted = prices.OrderBy(p => p).ToList();
        decimal median;
        int n = sorted.Count;
        if (n % 2 == 1)
            median = sorted[n / 2];
        else
            median = (sorted[n / 2 - 1] + sorted[n / 2]) / 2m;

        result.Add(("Media (Promedio)", $"${stats.Mean:N2}", ""));
        result.Add(("Mediana", $"${median:N2}", ""));
        result.Add(("Precio Mínimo", $"${stats.Min:N2}", "analytics-down"));
        result.Add(("Precio Máximo", $"${stats.Max:N2}", "analytics-up"));
        result.Add(("Rango de Precios", $"${(stats.Max - stats.Min):N2}", ""));
        result.Add(("Desviación Estándar", $"${stats.StdDev:N2}", ""));
        result.Add(("Coef. de Variación", $"{cv:F2}%", ""));

        return result;
    }

    /// <summary>
    /// Calcula las métricas analíticas del rango histórico seleccionado.
    /// Variación = ((precioFinal - precioInicial) / precioInicial) * 100
    /// </summary>
    private void ComputeAnalytics(
        List<HistoricalPriceData> prices,
        List<(DateTime Date, decimal Volume)> volumes)
    {
        if (!prices.Any()) return;
        var vals = prices.Select(p => p.Price).ToList();
        analyticsInitialPrice = vals.First();
        analyticsFinalPrice = vals.Last();
        analyticsMaxPrice = vals.Max();
        analyticsMinPrice = vals.Min();
        analyticsPctChange = analyticsInitialPrice > 0
            ? ((analyticsFinalPrice - analyticsInitialPrice) / analyticsInitialPrice) * 100m
            : 0m;
        analyticsAvgVolume = volumes.Any() ? volumes.Average(v => v.Volume) : (decimal?)null;
    }

    /// <summary>Formatea un precio USD con decimales adecuados según su magnitud.</summary>
    private static string FormatPrice(decimal price)
    {
        var abs = Math.Abs(price);
        if (abs >= 1000m) return $"USD {price:N2}";
        if (abs >= 1m) return $"USD {price:F2}";
        if (abs >= 0.01m) return $"USD {price:F4}";
        if (abs >= 0.0001m) return $"USD {price:F6}";
        return $"USD {price:F8}";
    }

    private IEnumerable<(string Symbol, string Name)> GetAvailableComparisonCoins()
    {
        var result = new List<(string Symbol, string Name)>(_staticComparisonCoins);
        foreach (var c in cryptos)
        {
            if (!result.Any(r => r.Symbol.Equals(c.Symbol, StringComparison.OrdinalIgnoreCase)))
                result.Add((c.Symbol.ToUpper(), c.Name));
        }
        return result;
    }

    private void ToggleCoinSelection(string symbol)
    {
        var existing = selectedCoins.FirstOrDefault(s => s.Equals(symbol, StringComparison.OrdinalIgnoreCase));
        if (existing != null)
            selectedCoins.Remove(existing);
        else
            selectedCoins.Add(symbol.ToUpper());
    }

    private async Task ClearComparison()
    {
        selectedCoins.Clear();
        compareFrom = null;
        compareTo = null;
        hasCompared = false;
        pieKpiMode = false;
        lineChartEmpty = false;
        showLineChart = false;
        chartMode = "percent";
        chartApiError = null;
        filterError = null;
        coinWarnings.Clear();
        analyticsInitialPrice = null;
        analyticsFinalPrice = null;
        analyticsMaxPrice = null;
        analyticsMinPrice = null;
        analyticsPctChange = null;
        analyticsAvgVolume = null;
        multiHistoricalData.Clear();
        marketCapData.Clear();
        change24hData.Clear();
        // Reinicializar los datepickers para limpiar su valor visual
        foreach (var pickerId in _pickerIds)
        {
            _initializedPickers.Remove(pickerId);
        }
        StateHasChanged();
        await Task.Yield();
        await RenderCharts();
    }

    private async Task OnCompareClicked()
    {
        if (isComparing) return;

        filterError = null;

        // Validar: al menos 1 moneda
        if (selectedCoins.Count < 1)
        {
            filterError = "Seleccioná al menos una moneda para comparar.";
            StateHasChanged();
            return;
        }

        // Validar: fecha desde y hasta son obligatorias
        if (!compareFrom.HasValue || !compareTo.HasValue)
        {
            filterError = "Seleccioná un período válido (fecha desde y hasta).";
            StateHasChanged();
            return;
        }

        // Validar: fecha desde ≤ fecha hasta
        if (compareFrom.Value.Date > compareTo.Value.Date)
        {
            filterError = "La fecha 'Desde' no puede ser posterior a la fecha 'Hasta'.";
            StateHasChanged();
            return;
        }

        // Validar: no fechas futuras
        if (compareFrom.Value.Date > DateTime.Today)
        {
            filterError = "La fecha 'Desde' no puede ser futura.";
            StateHasChanged();
            return;
        }

        isComparing = true;
        StateHasChanged();
        await ApplyComparison();
        isComparing = false;
        StateHasChanged();
    }

    private async Task ApplyComparison()
    {
        isComparing = true;
        filterError = null;
        coinWarnings.Clear();
        StateHasChanged();
        await Task.Yield();

        try
        {
            var allCoins = selectedCoins
                .Select(s => s.ToUpper())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            var fromDate = compareFrom!.Value.Date;
            var toDate = compareTo!.Value.Date > DateTime.Today ? DateTime.Today : compareTo!.Value.Date;

            // ── LOG: Parámetros de la consulta ──────────────────────────────
            Console.WriteLine($"[Stats] ▶ ApplyComparison: {allCoins.Count} moneda(s), " +
                $"rango [{fromDate:yyyy-MM-dd} → {toDate:yyyy-MM-dd}] " +
                $"({(toDate - fromDate).Days + 1} días)");
            foreach (var s in allCoins)
                Console.WriteLine($"[Stats]   Moneda solicitada: {s}");

            // ── FETCH: datos históricos para el rango exacto del usuario ──
            // Usamos GetCoinGeckoHistoricalDataAsync que genera datos simulados
            // realistas para el rango preciso (no hardcodeado a 90 días desde hoy).
            multiHistoricalData = new Dictionary<string, List<HistoricalPriceData>>(StringComparer.OrdinalIgnoreCase);

            foreach (var symbol in allCoins)
            {
                var histResult = await ApiService.GetCoinGeckoHistoricalDataAsync(symbol, fromDate, toDate);
                multiHistoricalData[symbol] = histResult.Prices;

                // ── LOG: resultado por moneda ──────────────────────────────
                Console.WriteLine($"[Stats]   {symbol}: {histResult.Prices.Count} puntos " +
                    $"[{fromDate:yyyy-MM-dd} → {toDate:yyyy-MM-dd}]" +
                    (!string.IsNullOrEmpty(histResult.ErrorMessage) ? $"  ⚠ {histResult.ErrorMessage}" : ""));

                if (histResult.Prices.Any())
                {
                    var first = histResult.Prices.First();
                    var last = histResult.Prices.Last();
                    var rendPct = first.Price > 0
                        ? Math.Round((last.Price - first.Price) / first.Price * 100.0m, 2)
                        : 0m;
                    Console.WriteLine($"[Stats]     Primer precio: {first.Price:F4} @ {first.Date:yyyy-MM-dd}");
                    Console.WriteLine($"[Stats]     Último precio:  {last.Price:F4} @ {last.Date:yyyy-MM-dd}");
                    Console.WriteLine($"[Stats]     Rendimiento:    {(rendPct >= 0 ? "+" : "")}{rendPct:F2}%");
                }
                else
                {
                    var warning = !string.IsNullOrEmpty(histResult.ErrorMessage)
                        ? histResult.ErrorMessage
                        : $"Sin datos disponibles para {symbol} en el período seleccionado.";
                    coinWarnings[symbol] = warning;
                    Console.WriteLine($"[Stats]     ⛔ SIN DATOS — {warning}");
                }
            }

            // ── MARKET CAP & 24h CHANGE ────────────────────────────────────
            marketCapData = new Dictionary<string, (decimal Today, decimal Yesterday)>(StringComparer.OrdinalIgnoreCase);
            change24hData = new Dictionary<string, decimal>(StringComparer.OrdinalIgnoreCase);
            foreach (var symbol in allCoins)
            {
                var dbCrypto = cryptos.FirstOrDefault(c => c.Symbol.Equals(symbol, StringComparison.OrdinalIgnoreCase));
                var simMc = await ApiService.GetYesterdayMarketCapAsync(symbol);
                var mcToday = (dbCrypto != null && dbCrypto.MarketCap > 0) ? dbCrypto.MarketCap : simMc.Today;
                marketCapData[symbol] = (mcToday, simMc.Yesterday);

                var change = (dbCrypto != null && dbCrypto.Change24h != 0)
                    ? dbCrypto.Change24h
                    : ApiService.GetSimulated24hChange(symbol);
                change24hData[symbol] = change;
            }

            // ── DETERMINAR MONEDAS CON DATOS VÁLIDOS ──────────────────────
            var coinsWithData = allCoins.Where(s => multiHistoricalData.TryGetValue(s, out var d) && d.Any()).ToList();

            pieKpiMode = allCoins.Count == 1;
            hasCompared = true;
            lineChartEmpty = coinsWithData.Count == 0;
            showLineChart = coinsWithData.Count > 0;

            if (coinsWithData.Count == 0)
            {
                var rangeDesc = fromDate == toDate
                    ? $"el día {fromDate:dd/MM/yyyy}"
                    : $"el período {fromDate:dd/MM/yyyy} – {toDate:dd/MM/yyyy}";
                filterError = $"No se encontraron datos para ninguna de las monedas seleccionadas en {rangeDesc}. " +
                              "Verificá que las fechas sean correctas o probá con otro rango.";
                Console.WriteLine($"[Stats] ⛔ Sin datos para ninguna moneda — {filterError}");
                StateHasChanged();
                return;
            }

            // ── ANALYTICS (primera moneda con datos) ──────────────────────
            var firstCoinData = multiHistoricalData[coinsWithData[0]];
            ComputeAnalytics(firstCoinData, new List<(DateTime, decimal)>());

            // ── TÍTULOS ───────────────────────────────────────────────────
            if (coinsWithData.Count == 1)
            {
                var coinName = GetAvailableComparisonCoins()
                    .Where(c => c.Symbol.Equals(coinsWithData[0], StringComparison.OrdinalIgnoreCase))
                    .Select(c => c.Name).FirstOrDefault() ?? coinsWithData[0];
                lineChartTitle = $"Evolución histórica de {coinName}";
                lineChartSubtitle = $"Precio de {coinName} — {fromDate:dd/MM/yyyy} a {toDate:dd/MM/yyyy}";
            }
            else
            {
                var n = coinsWithData.Count;
                var label = $"{n} moneda{(n != 1 ? "s" : "")}";
                var coinList = n > 1
                    ? string.Join(", ", coinsWithData.Take(n - 1)) + " y " + coinsWithData.Last()
                    : coinsWithData.FirstOrDefault() ?? "";
                lineChartTitle = chartMode == "percent"
                    ? $"Rendimiento porcentual ({label})"
                    : $"Evolución histórica ({label})";
                lineChartSubtitle = n >= 2
                    ? $"Comparativa de {coinList} — {fromDate} a {toDate}"
                    : $"Precio de {coinList} — {fromDate} a {toDate}";
            }

            StateHasChanged();
            await Task.Yield();
            await Task.Delay(80);

            await RenderComparisonLineChart(coinsWithData);

            // Pie chart
            if (!pieKpiMode && coinsWithData.Count >= 2)
            {
                var pieLabels = coinsWithData.ToArray();
                var pieCaps = coinsWithData.Select(s => marketCapData.ContainsKey(s) ? (double)marketCapData[s].Today : 0.0).ToArray();
                await JSRuntime.InvokeVoidAsync("renderPieChart", "pieChart", pieLabels, pieCaps, "Market Cap por moneda");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("destroyChart", "pieChart");
            }

            // Bar chart
            var barLabels = coinsWithData.ToArray();
            var barData = coinsWithData.Select(s => change24hData.ContainsKey(s) ? (double)change24hData[s] : 0.0).ToArray();
            await JSRuntime.InvokeVoidAsync("renderBarChart", "barChart", barLabels, barData);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Stats] ⛔ Excepción en ApplyComparison: {ex.Message}\n{ex.StackTrace}");
            filterError = $"Error inesperado al cargar datos: {ex.Message}";
            lineChartEmpty = true;
            showLineChart = false;
        }
        finally
        {
            isComparing = false;
            StateHasChanged();
        }
    }

    private async Task SwitchChartMode(string mode)
    {
        if (chartMode == mode || !hasCompared) return;
        chartMode = mode;

        var coinsWithData = selectedCoins
            .Select(s => s.ToUpper())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Where(s => multiHistoricalData.TryGetValue(s, out var d) && d.Any())
            .ToList();

        if (coinsWithData.Count >= 1)
        {
            var n = coinsWithData.Count;
            var label = $"{n} moneda{(n != 1 ? "s" : "")}";
            var coinList = n > 1
                ? string.Join(", ", coinsWithData.Take(n - 1)) + " y " + coinsWithData.Last()
                : coinsWithData.FirstOrDefault() ?? "";
            var fromDate = compareFrom?.ToString("dd/MM/yyyy") ?? "";
            var toDate = compareTo?.ToString("dd/MM/yyyy") ?? "";
            lineChartTitle = chartMode == "percent"
                ? $"Rendimiento porcentual ({label})"
                : $"Evolución histórica ({label})";
            lineChartSubtitle = n >= 2
                ? $"Comparativa de {coinList} — {fromDate} a {toDate}"
                : $"Precio de {coinList} — {fromDate} a {toDate}";
        }

        StateHasChanged();
        await Task.Yield();

        var allCoins = selectedCoins
            .Select(s => s.ToUpper())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        await RenderComparisonLineChart(allCoins);
    }

    private async Task RenderComparisonLineChart(List<string> allCoins)
    {
        try
        {
            // Build aligned data for each coin
            // Note: multiHistoricalData already contains data for the exact date range,
            // so FilterByDateRange is a safety net (should keep all points).
            var coinDataMap = allCoins
                .Where(s => multiHistoricalData.ContainsKey(s))
                .ToDictionary(s => s, s => FilterByDateRange(multiHistoricalData[s], compareFrom, compareTo));

            var validCoins = coinDataMap.Where(kv => kv.Value.Any()).Select(kv => kv.Key).ToList();

            Console.WriteLine($"[Stats] RenderComparisonLineChart: {validCoins.Count}/{allCoins.Count} moneda(s) con datos, mode={chartMode}");

            if (!validCoins.Any())
            {
                lineChartEmpty = true;
                showLineChart = false;
                Console.WriteLine("[Stats] ⛔ Sin monedas válidas tras FilterByDateRange — chart vacío.");
                StateHasChanged();
                return;
            }

            // Build union of all dates (sorted)
            var allDates = validCoins
                .SelectMany(s => coinDataMap[s].Select(d => d.Date.Date))
                .Distinct().OrderBy(d => d).ToList();

            var commonLabels = allDates.Select(d => d.ToString("dd/MM")).ToArray();

            Console.WriteLine($"[Stats]   Labels: {allDates.Count} fechas ({allDates.FirstOrDefault():yyyy-MM-dd} → {allDates.LastOrDefault():yyyy-MM-dd})");

            // Need at least 2 data points to draw any meaningful line
            if (allDates.Count < 2)
            {
                lineChartEmpty = true;
                showLineChart = false;
                filterError = "No hay suficientes datos históricos para graficar la evolución. " +
                              "Seleccioná un período de al menos 2 días.";
                Console.WriteLine("[Stats] ⛔ Menos de 2 fechas con datos — no se puede graficar.");
                await JSRuntime.InvokeVoidAsync("destroyChart", "lineChart");
                StateHasChanged();
                return;
            }

            if (chartMode == "percent" && validCoins.Count >= 2)
            {
                var lineDatasets = validCoins.Select(s =>
                {
                    var priceByDate = coinDataMap[s].ToDictionary(p => p.Date.Date, p => (double)p.Price);
                    var aligned = allDates.Select(d => priceByDate.TryGetValue(d, out var v) ? (double?)v : null).ToArray();
                    double initial = aligned.FirstOrDefault(p => p.HasValue) ?? 1.0;
                    if (initial == 0 || double.IsNaN(initial) || double.IsInfinity(initial)) initial = 1.0;
                    var pct = aligned.Select(p => p.HasValue
                        ? (double?)Math.Round((p.Value - initial) / initial * 100.0, 2)
                        : null).ToArray();
                    var nonNullPct = pct.Where(p => p.HasValue).Select(p => p!.Value).ToList();
                    Console.WriteLine($"[Stats]   {s}: {aligned.Count(p => p.HasValue)} pts | " +
                        $"initial={initial:F4} | " +
                        $"pct: min={(nonNullPct.Any() ? nonNullPct.Min().ToString("F2") : "N/A")}% " +
                        $"max={(nonNullPct.Any() ? nonNullPct.Max().ToString("F2") : "N/A")}% " +
                        $"last={(nonNullPct.Any() ? nonNullPct.Last().ToString("F2") : "N/A")}%");
                    return new { label = s, data = pct, originalData = aligned };
                }).ToArray();

                await JSRuntime.InvokeVoidAsync("renderLineChartMulti", "lineChart", commonLabels, lineDatasets, lineChartTitle,
"percent");
            }
            else
            {
                // Price mode (or single coin)
                var lineDatasets = validCoins.Select(s =>
                {
                    var priceByDate = coinDataMap[s].ToDictionary(p => p.Date.Date, p => (double)p.Price);
                    var aligned = allDates.Select(d => priceByDate.TryGetValue(d, out var v) ? (double?)v : null).ToArray();
                    var nonNull = aligned.Where(p => p.HasValue).Select(p => p!.Value).ToList();
                    Console.WriteLine($"[Stats]   {s}: {nonNull.Count} pts | " +
                        $"price: min={(nonNull.Any() ? nonNull.Min().ToString("F2") : "N/A")} " +
                        $"max={(nonNull.Any() ? nonNull.Max().ToString("F2") : "N/A")} " +
                        $"first={(nonNull.Any() ? nonNull.First().ToString("F4") : "N/A")}");
                    return new { label = s, data = aligned, originalData = aligned };
                }).ToArray();

                await JSRuntime.InvokeVoidAsync("renderLineChartMulti", "lineChart", commonLabels, lineDatasets, lineChartTitle,
"price");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Stats] ⛔ Error renderizando gráfico comparativo: {ex.Message}\n{ex.StackTrace}");
        }
    }

    private static List<HistoricalPriceData> FilterByDateRange(
        List<HistoricalPriceData> data, DateTime? from, DateTime? to)
    {
        var q = data.AsEnumerable();
        if (from.HasValue) q = q.Where(d => d.Date.Date >= from.Value.Date);
        if (to.HasValue) q = q.Where(d => d.Date.Date <= to.Value.Date);
        return q.ToList();
    }
